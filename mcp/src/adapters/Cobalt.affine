// Cobalt adapter - Static site generator in Rust
// https://cobalt-org.github.io/

open Adapter

fn name = "Cobalt"
fn language = "Rust"
fn description = "Straightforward static site generator written in Rust"

fn state: adapterState = {
  connected: false,
  projectPath: None,
}

fn connect = async () => {
  try {
    fn result = await Deno.Command.run("cobalt", ["--version"], None)
    state.connected = result.success
    result.success
  } catch {
  | _ => {
      state.connected = false
      false
    }
  }
}

fn disconnect = async () => {
  state.connected = false
}

fn isConnected = () => state.connected

// Helper to create JSON schema
fn makeSchema = (props: dict<JSON.t>, required: array<string>) => {
  fn schema = Dict.make()
  Dict.set(schema, "struct", JSON.Encode.string("object"))
  Dict.set(schema, "properties", JSON.Encode.object(props))
  if Array.length(required) > 0 {
    Dict.set(schema, "required", JSON.Encode.array(Array.map(required, JSON.Encode.string)))
  }
  JSON.Encode.object(schema)
}

fn makeProp = (structName: string, desc: string) =>
  JSON.Encode.object(
    Dict.fromArray([("struct", JSON.Encode.string(structName)), ("description", JSON.Encode.string(desc))]),
  )

fn tools: array<tool> = [
  {
    name: "cobalt_init",
    description: "Initialize a new Cobalt site",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path for the new site"))
      makeSchema(props, [])
    },
  },
  {
    name: "cobalt_build",
    description: "Build the Cobalt site",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to site root"))
      Dict.set(props, "destination", makeProp("string", "Output directory"))
      Dict.set(props, "drafts", makeProp("boolean", "Include drafts"))
      makeSchema(props, [])
    },
  },
  {
    name: "cobalt_serve",
    description: "Start Cobalt development server",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to site root"))
      Dict.set(props, "port", makeProp("number", "Port number"))
      Dict.set(props, "host", makeProp("string", "Host to bind to"))
      Dict.set(props, "drafts", makeProp("boolean", "Include drafts"))
      makeSchema(props, [])
    },
  },
  {
    name: "cobalt_watch",
    description: "Watch for changes and rebuild",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to site root"))
      makeSchema(props, [])
    },
  },
  {
    name: "cobalt_clean",
    description: "Clean the build directory",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to site root"))
      makeSchema(props, [])
    },
  },
  {
    name: "cobalt_new",
    description: "Create a new post",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to site root"))
      Dict.set(props, "title", makeProp("string", "Post title"))
      makeSchema(props, ["title"])
    },
  },
  {
    name: "cobalt_version",
    description: "Get Cobalt version",
    inputSchema: makeSchema(Dict.make(), []),
  },
]

// Tool execution handlers
fn executeInit = async (path: option<string>) => {
  fn args = ["init"]
  fn args = switch path {
  | Some(p) => Array.concat(args, [p])
  | None => args
  }
  await Deno.Command.run("cobalt", args, None)
}

fn executeBuild = async (path: option<string>, destination: option<string>, drafts: option<bool>) => {
  fn args = ["build"]
  fn args = switch destination {
  | Some(d) => Array.concat(args, ["--destination", d])
  | None => args
  }
  fn args = switch drafts {
  | Some(true) => Array.concat(args, ["--drafts"])
  | _ => args
  }
  await Deno.Command.run("cobalt", args, path)
}

fn executeServe = async (path: option<string>, port: option<int>, host: option<string>, drafts: option<bool>) => {
  fn args = ["serve"]
  fn args = switch port {
  | Some(p) => Array.concat(args, ["--port", Int.toString(p)])
  | None => args
  }
  fn args = switch host {
  | Some(h) => Array.concat(args, ["--host", h])
  | None => args
  }
  fn args = switch drafts {
  | Some(true) => Array.concat(args, ["--drafts"])
  | _ => args
  }
  await Deno.Command.run("cobalt", args, path)
}

fn executeWatch = async (path: option<string>) => {
  await Deno.Command.run("cobalt", ["watch"], path)
}

fn executeClean = async (path: option<string>) => {
  await Deno.Command.run("cobalt", ["clean"], path)
}

fn executeNew = async (path: option<string>, title: string) => {
  await Deno.Command.run("cobalt", ["new", title], path)
}

fn executeVersion = async () => {
  await Deno.Command.run("cobalt", ["--version"], None)
}

