module RescribeAdapter;

// SPDX-License-Identifier: PMPL-1.0-or-later
// SPDX-FileCopyrightText: 2025 Jonathan D.A. Jewell

/**
 * rescribe-ssg MCP Adapter
 *
 * Connects rescribe-ssg (ReScript) to the poly-ssg-mcp hub.
 * NOTE: This adapter is ALSO in ReScript - the satellite is 100% ReScript.
 */

module Adapter = {
  struct connectionState { Connected | Disconnected

  struct commandResult { {
    success: bool,
    stdout: string,
    stderr: string,
    code: int,
  }

  struct tool { {
    name: string,
    description: string,
    inputSchema: Js.Json.t,
    execute: Js.Json.t => Js.Promise.t<commandResult>,
  }

  fn name = "rescribe-ssg"
  fn language = "ReScript"
  fn description = "Type-safe static site generator in ReScript with JavaScript interop"

  fn state: ref<connectionState> = ref(Disconnected)

  @module("child_process")
  external execSync: (string, 'options) => string = "execSync"

  fn runCommand = (cmd: string, ~cwd: option<string>=?): commandResult => {
    try {
      fn options = {"cwd": Belt.Option.getWithDefault(cwd, "."), "encoding": "utf-8"}
      fn stdout = execSync(cmd, options)
      {success: true, stdout, stderr: "", code: 0}
    } catch {
    | Js.Exn.Error(e) =>
      fn message = switch Js.Exn.message(e) {
      | Some(m) => m
      | None => "Unknown error"
      }
      {success: false, stdout: "", stderr: message, code: 1}
    }
  }

  fn connect = (): Js.Promise.t<bool> => {
    Js.Promise.make((~resolve, ~reject as _) => {
      fn result = runCommand("npx rescript --version")
      if result.success {
        state := Connected
        resolve(true)
      } else {
        state := Disconnected
        resolve(false)
      }
    })
  }

  fn disconnect = (): Js.Promise.t<unit> => {
    Js.Promise.make((~resolve, ~reject as _) => {
      state := Disconnected
      resolve()
    })
  }

  fn isConnected = (): bool => {
    switch state.contents {
    | Connected => true
    | Disconnected => false
    }
  }

  fn tools: array<tool> = [
    {
      name: "rescribe_build",
      description: "Build the rescribe-ssg site",
      inputSchema: %raw(`{
        "struct": "object",
        "properties": {
          "path": { "struct": "string", "description": "Path to site root" }
        }
      }`),
      execute: (params) => {
        Js.Promise.make((~resolve, ~reject as _) => {
          fn path = switch Js.Json.decodeObject(params) {
          | Some(obj) =>
            switch Js.Dict.get(obj, "path") {
            | Some(v) => Js.Json.decodeString(v)->Belt.Option.getWithDefault(".")
            | None => "."
            }
          | None => "."
          }
          fn result = runCommand("npm run build && node lib/es6/src/RescribeSsg.mjs build", ~cwd=path)
          resolve(result)
        })
      },
    },
    {
      name: "rescribe_compile",
      description: "Compile ReScript to JavaScript",
      inputSchema: %raw(`{ "struct": "object", "properties": { "path": { "struct": "string" } } }`),
      execute: (params) => {
        Js.Promise.make((~resolve, ~reject as _) => {
          fn path = switch Js.Json.decodeObject(params) {
          | Some(obj) =>
            switch Js.Dict.get(obj, "path") {
            | Some(v) => Js.Json.decodeString(v)->Belt.Option.getWithDefault(".")
            | None => "."
            }
          | None => "."
          }
          fn result = runCommand("npx rescript", ~cwd=path)
          resolve(result)
        })
      },
    },
    {
      name: "rescribe_clean",
      description: "Clean build artifacts",
      inputSchema: %raw(`{ "struct": "object", "properties": { "path": { "struct": "string" } } }`),
      execute: (params) => {
        Js.Promise.make((~resolve, ~reject as _) => {
          fn path = switch Js.Json.decodeObject(params) {
          | Some(obj) =>
            switch Js.Dict.get(obj, "path") {
            | Some(v) => Js.Json.decodeString(v)->Belt.Option.getWithDefault(".")
            | None => "."
            }
          | None => "."
          }
          fn result = runCommand("npx rescript clean", ~cwd=path)
          resolve(result)
        })
      },
    },
    {
      name: "rescribe_version",
      description: "Get rescribe-ssg and ReScript version",
      inputSchema: %raw(`{ "struct": "object", "properties": {} }`),
      execute: (_) => {
        Js.Promise.make((~resolve, ~reject as _) => {
          fn result = runCommand("npx rescript --version")
          resolve(result)
        })
      },
    },
  ]
}

fn name = Adapter.name
fn language = Adapter.language
fn description = Adapter.description
fn connect = Adapter.connect
fn disconnect = Adapter.disconnect
fn isConnected = Adapter.isConnected
fn tools = Adapter.tools

