module ScalaTex;

// SPDX-License-Identifier: MIT
// SPDX-FileCopyrightText: 2025 Jonathan D.A. Jewell

// ScalaTex adapter - LaTeX/PDF generation in Scala
// Document generation using Scala and LaTeX

open Adapter

fn name = "ScalaTex"
fn language = "Scala"
fn description = "Document and site generation using Scala with LaTeX support"

fn state: adapterState = {
  connected: false,
  projectPath: None,
}

fn connect = async () => {
  try {
    fn result = await Deno.Command.run("mill", ["--version"], None)
    state.connected = result.success
    result.success
  } catch {
  | _ => {
      state.connected = false
      false
    }
  }
}

fn disconnect = async () => {
  state.connected = false
}

fn isConnected = () => state.connected

fn makeSchema = (props: dict<JSON.t>, required: array<string>) => {
  fn schema = Dict.make()
  Dict.set(schema, "struct", JSON.Encode.string("object"))
  Dict.set(schema, "properties", JSON.Encode.object(props))
  if Array.length(required) > 0 {
    Dict.set(schema, "required", JSON.Encode.array(Array.map(required, JSON.Encode.string)))
  }
  JSON.Encode.object(schema)
}

fn makeProp = (structName: string, desc: string) =>
  JSON.Encode.object(
    Dict.fromArray([("struct", JSON.Encode.string(structName)), ("description", JSON.Encode.string(desc))]),
  )

fn tools: array<tool> = [
  {
    name: "scalatex_init",
    description: "Initialize a new ScalaTex project",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "name", makeProp("string", "Project name"))
      Dict.set(props, "path", makeProp("string", "Path for the project"))
      makeSchema(props, ["name"])
    },
  },
  {
    name: "scalatex_build",
    description: "Build the ScalaTex document/site",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to project root"))
      Dict.set(props, "target", makeProp("string", "Build target (html, pdf)"))
      makeSchema(props, [])
    },
  },
  {
    name: "scalatex_watch",
    description: "Watch and rebuild on changes",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to project root"))
      makeSchema(props, [])
    },
  },
  {
    name: "scalatex_clean",
    description: "Clean build artifacts",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to project root"))
      makeSchema(props, [])
    },
  },
  {
    name: "scalatex_version",
    description: "Get Mill/Scala version",
    inputSchema: makeSchema(Dict.make(), []),
  },
]

fn executeInit = async (name: string, path: option<string>) => {
  await Deno.Command.run("mill", ["init", name], path)
}

fn executeBuild = async (path: option<string>, target: option<string>) => {
  fn targetName = switch target {
  | Some(t) => t
  | None => "compile"
  }
  await Deno.Command.run("mill", [targetName], path)
}

fn executeWatch = async (path: option<string>) => {
  await Deno.Command.run("mill", ["-w", "compile"], path)
}

fn executeClean = async (path: option<string>) => {
  await Deno.Command.run("mill", ["clean"], path)
}

fn executeVersion = async () => {
  await Deno.Command.run("mill", ["--version"], None)
}

