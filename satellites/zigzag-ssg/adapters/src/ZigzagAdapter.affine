module ZigzagAdapter;

// SPDX-License-Identifier: PMPL-1.0-or-later
// SPDX-FileCopyrightText: 2025 Jonathan D.A. Jewell

/**
 * zigzag-ssg MCP Adapter
 *
 * Connects zigzag-ssg (Zig) to the poly-ssg-mcp hub.
 * This is the ONLY place non-Zig code is allowed in this satellite.
 */

module Adapter = {
  struct connectionState { Connected | Disconnected

  struct commandResult { {
    success: bool,
    stdout: string,
    stderr: string,
    code: int,
  }

  struct tool { {
    name: string,
    description: string,
    inputSchema: Js.Json.t,
    execute: Js.Json.t => Js.Promise.t<commandResult>,
  }

  fn name = "zigzag-ssg"
  fn language = "Zig"
  fn description = "High-performance static site generator in Zig with zero-overhead abstractions"

  fn mutable state: connectionState = Disconnected

  @module("child_process")
  external execSync: (string, 'options) => string = "execSync"

  fn runCommand = (cmd: string, ~cwd: option<string>=?): commandResult => {
    try {
      fn options = switch cwd {
      | Some(dir) => {"cwd": dir, "encoding": "utf-8"}
      | None => {"encoding": "utf-8"}
      }
      fn stdout = execSync(cmd, options)
      {success: true, stdout, stderr: "", code: 0}
    } catch {
    | Js.Exn.Error(e) =>
      fn message = switch Js.Exn.message(e) {
      | Some(m) => m
      | None => "Unknown error"
      }
      {success: false, stdout: "", stderr: message, code: 1}
    }
  }

  fn connect = (): Js.Promise.t<bool> => {
    Js.Promise.make((~resolve, ~reject as _) => {
      fn result = runCommand("zig version")
      if result.success {
        state = Connected
        resolve(true)
      } else {
        state = Disconnected
        resolve(false)
      }
    })
  }

  fn disconnect = (): Js.Promise.t<unit> => {
    Js.Promise.make((~resolve, ~reject as _) => {
      state = Disconnected
      resolve()
    })
  }

  fn isConnected = (): bool => {
    switch state {
    | Connected => true
    | Disconnected => false
    }
  }

  fn tools: array<tool> = [
    {
      name: "zigzag_build",
      description: "Build the zigzag-ssg site",
      inputSchema: %raw(`{
        "struct": "object",
        "properties": {
          "path": { "struct": "string", "description": "Path to site root" },
          "release": { "struct": "boolean", "description": "Build in release mode" }
        }
      }`),
      execute: (params) => {
        Js.Promise.make((~resolve, ~reject as _) => {
          fn path = switch Js.Json.decodeObject(params) {
          | Some(obj) =>
            switch Js.Dict.get(obj, "path") {
            | Some(v) => Js.Json.decodeString(v)->Belt.Option.getWithDefault(".")
            | None => "."
            }
          | None => "."
          }
          fn release = switch Js.Json.decodeObject(params) {
          | Some(obj) =>
            switch Js.Dict.get(obj, "release") {
            | Some(v) => Js.Json.decodeBoolean(v)->Belt.Option.getWithDefault(false)
            | None => false
            }
          | None => false
          }
          fn mode = release ? "-Doptimize=ReleaseFast" : ""
          fn result = runCommand(`zig build ${mode}`, ~cwd=Some(path))
          resolve(result)
        })
      },
    },
    {
      name: "zigzag_run",
      description: "Build and run the zigzag-ssg",
      inputSchema: %raw(`{
        "struct": "object",
        "properties": {
          "path": { "struct": "string" },
          "args": { "struct": "array", "items": { "struct": "string" } }
        }
      }`),
      execute: (params) => {
        Js.Promise.make((~resolve, ~reject as _) => {
          fn path = switch Js.Json.decodeObject(params) {
          | Some(obj) =>
            switch Js.Dict.get(obj, "path") {
            | Some(v) => Js.Json.decodeString(v)->Belt.Option.getWithDefault(".")
            | None => "."
            }
          | None => "."
          }
          fn result = runCommand("zig build run", ~cwd=Some(path))
          resolve(result)
        })
      },
    },
    {
      name: "zigzag_test",
      description: "Run zigzag-ssg tests",
      inputSchema: %raw(`{ "struct": "object", "properties": { "path": { "struct": "string" } } }`),
      execute: (params) => {
        Js.Promise.make((~resolve, ~reject as _) => {
          fn path = switch Js.Json.decodeObject(params) {
          | Some(obj) =>
            switch Js.Dict.get(obj, "path") {
            | Some(v) => Js.Json.decodeString(v)->Belt.Option.getWithDefault(".")
            | None => "."
            }
          | None => "."
          }
          fn result = runCommand("zig build test", ~cwd=Some(path))
          resolve(result)
        })
      },
    },
    {
      name: "zigzag_version",
      description: "Get zigzag-ssg and Zig version",
      inputSchema: %raw(`{ "struct": "object", "properties": {} }`),
      execute: (_) => {
        Js.Promise.make((~resolve, ~reject as _) => {
          fn result = runCommand("zig version")
          resolve(result)
        })
      },
    },
  ]
}

fn name = Adapter.name
fn language = Adapter.language
fn description = Adapter.description
fn connect = Adapter.connect
fn disconnect = Adapter.disconnect
fn isConnected = Adapter.isConnected
fn tools = Adapter.tools

