module Laika;

// SPDX-License-Identifier: MIT
// SPDX-FileCopyrightText: 2025 Jonathan D.A. Jewell

// Laika adapter - Text markup transformer in Scala
// https://planet42.github.io/Laika/

open Adapter

fn name = "Laika"
fn language = "Scala"
fn description = "Customizable text markup transformer and site generator in Scala"

fn state: adapterState = {
  connected: false,
  projectPath: None,
}

fn connect = async () => {
  try {
    fn result = await Deno.Command.run("laika", ["--version"], None)
    state.connected = result.success
    result.success
  } catch {
  | _ => {
      state.connected = false
      false
    }
  }
}

fn disconnect = async () => {
  state.connected = false
}

fn isConnected = () => state.connected

fn makeSchema = (props: dict<JSON.t>, required: array<string>) => {
  fn schema = Dict.make()
  Dict.set(schema, "struct", JSON.Encode.string("object"))
  Dict.set(schema, "properties", JSON.Encode.object(props))
  if Array.length(required) > 0 {
    Dict.set(schema, "required", JSON.Encode.array(Array.map(required, JSON.Encode.string)))
  }
  JSON.Encode.object(schema)
}

fn makeProp = (structName: string, desc: string) =>
  JSON.Encode.object(
    Dict.fromArray([("struct", JSON.Encode.string(structName)), ("description", JSON.Encode.string(desc))]),
  )

fn tools: array<tool> = [
  {
    name: "laika_transform",
    description: "Transform markup files",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "input", makeProp("string", "Input directory or file"))
      Dict.set(props, "output", makeProp("string", "Output directory"))
      Dict.set(props, "format", makeProp("string", "Output format (html, epub, pdf, ast)"))
      makeSchema(props, ["input", "output"])
    },
  },
  {
    name: "laika_generate",
    description: "Generate a site from markup",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to project root"))
      Dict.set(props, "output", makeProp("string", "Output directory"))
      makeSchema(props, [])
    },
  },
  {
    name: "laika_preview",
    description: "Start preview server",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to project root"))
      Dict.set(props, "port", makeProp("number", "Port number"))
      makeSchema(props, [])
    },
  },
  {
    name: "laika_version",
    description: "Get Laika version",
    inputSchema: makeSchema(Dict.make(), []),
  },
]

fn executeTransform = async (input: string, output: string, format: option<string>) => {
  fn args = ["transform", input, output]
  fn args = switch format {
  | Some(f) => Array.concat(args, ["--format", f])
  | None => args
  }
  await Deno.Command.run("laika", args, None)
}

fn executeGenerate = async (path: option<string>, output: option<string>) => {
  fn args = ["generate"]
  fn args = switch output {
  | Some(o) => Array.concat(args, ["--output", o])
  | None => args
  }
  await Deno.Command.run("laika", args, path)
}

fn executePreview = async (path: option<string>, port: option<int>) => {
  fn args = ["preview"]
  fn args = switch port {
  | Some(p) => Array.concat(args, ["--port", Int.toString(p)])
  | None => args
  }
  await Deno.Command.run("laika", args, path)
}

fn executeVersion = async () => {
  await Deno.Command.run("laika", ["--version"], None)
}

