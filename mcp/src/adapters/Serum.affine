module Serum;

// SPDX-License-Identifier: MIT
// SPDX-FileCopyrightText: 2025 Jonathan D.A. Jewell

// Serum adapter - Static site generator in Elixir
// https://dalgona.github.io/Serum/

open Adapter

fn name = "Serum"
fn language = "Elixir"
fn description = "Simple static website generator written in Elixir"

fn state: adapterState = {
  connected: false,
  projectPath: None,
}

fn connect = async () => {
  try {
    fn result = await Deno.Command.run("mix", ["--version"], None)
    state.connected = result.success
    result.success
  } catch {
  | _ => {
      state.connected = false
      false
    }
  }
}

fn disconnect = async () => {
  state.connected = false
}

fn isConnected = () => state.connected

fn makeSchema = (props: dict<JSON.t>, required: array<string>) => {
  fn schema = Dict.make()
  Dict.set(schema, "struct", JSON.Encode.string("object"))
  Dict.set(schema, "properties", JSON.Encode.object(props))
  if Array.length(required) > 0 {
    Dict.set(schema, "required", JSON.Encode.array(Array.map(required, JSON.Encode.string)))
  }
  JSON.Encode.object(schema)
}

fn makeProp = (structName: string, desc: string) =>
  JSON.Encode.object(
    Dict.fromArray([("struct", JSON.Encode.string(structName)), ("description", JSON.Encode.string(desc))]),
  )

fn tools: array<tool> = [
  {
    name: "serum_init",
    description: "Initialize a new Serum project",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path for the new project"))
      makeSchema(props, ["path"])
    },
  },
  {
    name: "serum_build",
    description: "Build the Serum site",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to project root"))
      Dict.set(props, "output", makeProp("string", "Output directory"))
      makeSchema(props, [])
    },
  },
  {
    name: "serum_server",
    description: "Start Serum development server",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to project root"))
      Dict.set(props, "port", makeProp("number", "Port number (default: 8080)"))
      makeSchema(props, [])
    },
  },
  {
    name: "serum_version",
    description: "Get Serum version",
    inputSchema: makeSchema(Dict.make(), []),
  },
]

fn executeInit = async (path: string) => {
  await Deno.Command.run("mix", ["serum.new", path], None)
}

fn executeBuild = async (path: option<string>, output: option<string>) => {
  fn args = ["serum.build"]
  fn args = switch output {
  | Some(o) => Array.concat(args, ["--output", o])
  | None => args
  }
  await Deno.Command.run("mix", args, path)
}

fn executeServer = async (path: option<string>, port: option<int>) => {
  fn args = ["serum.server"]
  fn args = switch port {
  | Some(p) => Array.concat(args, ["--port", Int.toString(p)])
  | None => args
  }
  await Deno.Command.run("mix", args, path)
}

fn executeVersion = async () => {
  await Deno.Command.run("mix", ["serum", "--version"], None)
}

