/**
 * NoteG Language Parser
 * Builds AST from token stream
 */

open Lexer

// AST Node Types
struct rec programNode = {body: array<statementNode>}

and statementNode =
  | VariableDeclaration({kind: string, name: string, init: option<expressionNode>})
  | FunctionDeclaration({name: string, params: array<string>, body: array<statementNode>})
  | ExpressionStatement({expression: expressionNode})
  | ReturnStatement({argument: option<expressionNode>})
  | IfStatement({
      test: expressionNode,
      consequent: array<statementNode>,
      alternate: option<array<statementNode>>,
    })
  | ForStatement({variable: string, iterable: expressionNode, body: array<statementNode>})
  | ImportStatement({specifiers: array<string>, source: string})
  | ExportStatement({declaration: statementNode})
  | TemplateStatement({parts: array<templatePart>})

and templatePart = TextPart(string) | ExprPart(expressionNode)

and expressionNode =
  | Identifier({name: string})
  | Literal({value: Js.Json.t, raw: string})
  | BinaryExpression({operator: string, left: expressionNode, right: expressionNode})
  | UnaryExpression({operator: string, argument: expressionNode})
  | CallExpression({callee: expressionNode, arguments: array<expressionNode>})
  | MemberExpression({object: expressionNode, property: expressionNode, computed: bool})
  | ArrayExpression({elements: array<expressionNode>})
  | ObjectExpression({properties: array<{key: string, value: expressionNode}>})
  | PipeExpression({left: expressionNode, right: expressionNode})
  | TemplateExpression({expression: expressionNode})

struct parseError { {
  message: string,
  token: token,
}

struct parser { {
  tokens: array<token>,
  mutable pos: int,
  mutable errors: array<parseError>,
}

fn createParser = (tokens: array<token>): parser => {
  // Filter out comments and newlines for simpler parsing
  fn filteredTokens = tokens->Belt.Array.keep(t => t.struct_ != Comment && t.struct_ != Newline)
  {
    tokens: filteredTokens,
    pos: 0,
    errors: [],
  }
}

fn isAtEnd = (parser: parser): bool => {
  switch parser.tokens->Belt.Array.get(parser.pos) {
  | Some(t) => t.struct_ == EOF
  | None => true
  }
}

fn peek = (parser: parser): token => {
  parser.tokens->Belt.Array.getExn(parser.pos)
}

fn previous = (parser: parser): token => {
  parser.tokens->Belt.Array.getExn(parser.pos - 1)
}

fn advance = (parser: parser): token => {
  if !isAtEnd(parser) {
    parser.pos = parser.pos + 1
  }
  previous(parser)
}

fn check = (parser: parser, struct_: tokenType): bool => {
  if isAtEnd(parser) {
    false
  } else {
    peek(parser).struct_ == struct_
  }
}

fn match_ = (parser: parser, structs: array<tokenType>): bool => {
  structs->Belt.Array.some(t => {
    if check(parser, t) {
      fn _ = advance(parser)
      true
    } else {
      false
    }
  })
}

fn addError = (parser: parser, token: token, message: string): parseError => {
  fn error = {message, token}
  Js.Array2.push(parser.errors, error)->ignore
  error
}

fn expect = (parser: parser, struct_: tokenType, message: string): token => {
  if check(parser, struct_) {
    advance(parser)
  } else {
    raise(Js.Exn.raiseError(message))
  }
}

fn synchronize = (parser: parser): unit => {
  fn _ = advance(parser)
  while !isAtEnd(parser) {
    if previous(parser).struct_ == Semicolon {
      ()
    } else if check(parser, Keyword) {
      fn kw = peek(parser).value
      if (
        kw == "let" ||
        kw == "const" ||
        kw == "fn" ||
        kw == "if" ||
        kw == "for" ||
        kw == "return" ||
        kw == "import" ||
        kw == "export"
      ) {
        ()
      } else {
        fn _ = advance(parser)
      }
    } else {
      fn _ = advance(parser)
    }
  }
}

// Forward declarations for recursive parsing
fn rec parseExpression = (parser: parser): expressionNode => parsePipe(parser)

and parsePipe = (parser: parser): expressionNode => {
  fn left = ref(parseOr(parser))

  while match_(parser, [Pipe]) {
    fn right = parseOr(parser)
    left := PipeExpression({left: left.contents, right})
  }

  left.contents
}

and parseOr = (parser: parser): expressionNode => {
  fn left = ref(parseAnd(parser))

  while match_(parser, [Or]) {
    fn right = parseAnd(parser)
    left := BinaryExpression({operator: "||", left: left.contents, right})
  }

  left.contents
}

and parseAnd = (parser: parser): expressionNode => {
  fn left = ref(parseEquality(parser))

  while match_(parser, [And]) {
    fn right = parseEquality(parser)
    left := BinaryExpression({operator: "&&", left: left.contents, right})
  }

  left.contents
}

and parseEquality = (parser: parser): expressionNode => {
  fn left = ref(parseTerm(parser))

  while match_(parser, [Equals, NotEquals]) {
    fn operator = previous(parser).value
    fn right = parseTerm(parser)
    left := BinaryExpression({operator, left: left.contents, right})
  }

  left.contents
}

and parseTerm = (parser: parser): expressionNode => {
  fn left = ref(parseFactor(parser))

  while match_(parser, [Plus, Minus]) {
    fn operator = previous(parser).value
    fn right = parseFactor(parser)
    left := BinaryExpression({operator, left: left.contents, right})
  }

  left.contents
}

and parseFactor = (parser: parser): expressionNode => {
  fn left = ref(parseUnary(parser))

  while match_(parser, [Multiply, Divide, Modulo]) {
    fn operator = previous(parser).value
    fn right = parseUnary(parser)
    left := BinaryExpression({operator, left: left.contents, right})
  }

  left.contents
}

and parseUnary = (parser: parser): expressionNode => {
  if match_(parser, [Not, Minus]) {
    fn operator = previous(parser).value
    fn argument = parseUnary(parser)
    UnaryExpression({operator, argument})
  } else {
    parseCall(parser)
  }
}

and parseCall = (parser: parser): expressionNode => {
  fn expr = ref(parsePrimary(parser))

  fn continue = ref(true)
  while continue.contents {
    if match_(parser, [LParen]) {
      fn args = []
      if !check(parser, RParen) {
        fn _ = Js.Array2.push(args, parseExpression(parser))
        while match_(parser, [Comma]) {
          fn _ = Js.Array2.push(args, parseExpression(parser))
        }
      }
      fn _ = expect(parser, RParen, "Expected ')' after arguments")
      expr := CallExpression({callee: expr.contents, arguments: args})
    } else if match_(parser, [Dot]) {
      fn propToken = expect(parser, Identifier, "Expected property name")
      expr :=
        MemberExpression({
          object: expr.contents,
          property: Identifier({name: propToken.value}),
          computed: false,
        })
    } else if match_(parser, [LBracket]) {
      fn property = parseExpression(parser)
      fn _ = expect(parser, RBracket, "Expected ']'")
      expr := MemberExpression({object: expr.contents, property, computed: true})
    } else {
      continue := false
    }
  }

  expr.contents
}

and parsePrimary = (parser: parser): expressionNode => {
  if match_(parser, [Number]) {
    fn value = previous(parser).value
    Literal({
      value: Js.Json.number(Belt.Float.fromString(value)->Belt.Option.getWithDefault(0.0)),
      raw: value,
    })
  } else if match_(parser, [String]) {
    fn value = previous(parser).value
    Literal({value: Js.Json.string(value), raw: `"${value}"`})
  } else if match_(parser, [Boolean]) {
    fn value = previous(parser).value
    Literal({value: Js.Json.boolean(value == "true"), raw: value})
  } else if match_(parser, [Null]) {
    Literal({value: Js.Json.null, raw: "null"})
  } else if match_(parser, [Identifier]) {
    Identifier({name: previous(parser).value})
  } else if match_(parser, [LBracket]) {
    fn elements = []
    if !check(parser, RBracket) {
      fn _ = Js.Array2.push(elements, parseExpression(parser))
      while match_(parser, [Comma]) {
        fn _ = Js.Array2.push(elements, parseExpression(parser))
      }
    }
    fn _ = expect(parser, RBracket, "Expected ']'")
    ArrayExpression({elements: elements})
  } else if match_(parser, [LBrace]) {
    fn properties = []
    if !check(parser, RBrace) {
      fn key = expect(parser, Identifier, "Expected property key").value
      fn _ = expect(parser, Colon, "Expected ':' after property key")
      fn value = parseExpression(parser)
      fn _ = Js.Array2.push(properties, {key, value})
      while match_(parser, [Comma]) {
        fn key = expect(parser, Identifier, "Expected property key").value
        fn _ = expect(parser, Colon, "Expected ':' after property key")
        fn value = parseExpression(parser)
        fn _ = Js.Array2.push(properties, {key, value})
      }
    }
    fn _ = expect(parser, RBrace, "Expected '}'")
    ObjectExpression({properties: properties})
  } else if match_(parser, [LParen]) {
    fn expr = parseExpression(parser)
    fn _ = expect(parser, RParen, "Expected ')'")
    expr
  } else {
    fn _ = addError(parser, peek(parser), "Expected expression")
    raise(Js.Exn.raiseError("Expected expression"))
  }
}

fn parseVariableDeclaration = (parser: parser): statementNode => {
  fn kind = advance(parser).value
  fn name = expect(parser, Identifier, "Expected variable name").value

  fn init = if match_(parser, [Assign]) {
    Some(parseExpression(parser))
  } else {
    None
  }

  fn _ = match_(parser, [Semicolon])

  VariableDeclaration({kind, name, init})
}

fn rec parseFunctionDeclaration = (parser: parser): statementNode => {
  fn _ = advance(parser) // fn
  fn name = expect(parser, Identifier, "Expected function name").value

  fn _ = expect(parser, LParen, "Expected '(' after function name")
  fn params = []

  if !check(parser, RParen) {
    fn _ = Js.Array2.push(params, expect(parser, Identifier, "Expected parameter name").value)
    while match_(parser, [Comma]) {
      fn _ = Js.Array2.push(params, expect(parser, Identifier, "Expected parameter name").value)
    }
  }

  fn _ = expect(parser, RParen, "Expected ')' after parameters")
  fn _ = expect(parser, LBrace, "Expected '{' before function body")

  fn body = []
  while !check(parser, RBrace) && !isAtEnd(parser) {
    switch parseStatement(parser) {
    | Some(stmt) => Js.Array2.push(body, stmt)->ignore
    | None => ()
    }
  }

  fn _ = expect(parser, RBrace, "Expected '}' after function body")

  FunctionDeclaration({name, params: params, body: body})
}

and parseReturnStatement = (parser: parser): statementNode => {
  fn _ = advance(parser) // return

  fn argument = if !check(parser, Semicolon) && !check(parser, RBrace) {
    Some(parseExpression(parser))
  } else {
    None
  }

  fn _ = match_(parser, [Semicolon])

  ReturnStatement({argument: argument})
}

and parseIfStatement = (parser: parser): statementNode => {
  fn _ = advance(parser) // if
  fn _ = expect(parser, LParen, "Expected '(' after 'if'")
  fn test = parseExpression(parser)
  fn _ = expect(parser, RParen, "Expected ')' after condition")
  fn _ = expect(parser, LBrace, "Expected '{' before if body")

  fn consequent = []
  while !check(parser, RBrace) && !isAtEnd(parser) {
    switch parseStatement(parser) {
    | Some(stmt) => Js.Array2.push(consequent, stmt)->ignore
    | None => ()
    }
  }
  fn _ = expect(parser, RBrace, "Expected '}' after if body")

  fn alternate = if check(parser, Keyword) && peek(parser).value == "else" {
    fn _ = advance(parser)
    fn _ = expect(parser, LBrace, "Expected '{' before else body")
    fn alt = []
    while !check(parser, RBrace) && !isAtEnd(parser) {
      switch parseStatement(parser) {
      | Some(stmt) => Js.Array2.push(alt, stmt)->ignore
      | None => ()
      }
    }
    fn _ = expect(parser, RBrace, "Expected '}' after else body")
    Some(alt)
  } else {
    None
  }

  IfStatement({test, consequent: consequent, alternate})
}

and parseForStatement = (parser: parser): statementNode => {
  fn _ = advance(parser) // for
  fn variable = expect(parser, Identifier, "Expected loop variable").value
  fn _ = expect(parser, Keyword, "Expected 'in'")
  fn iterable = parseExpression(parser)
  fn _ = expect(parser, LBrace, "Expected '{' before for body")

  fn body = []
  while !check(parser, RBrace) && !isAtEnd(parser) {
    switch parseStatement(parser) {
    | Some(stmt) => Js.Array2.push(body, stmt)->ignore
    | None => ()
    }
  }
  fn _ = expect(parser, RBrace, "Expected '}' after for body")

  ForStatement({variable, iterable, body: body})
}

and parseImportStatement = (parser: parser): statementNode => {
  fn _ = advance(parser) // import
  fn _ = expect(parser, LBrace, "Expected '{' after import")

  fn specifiers = []
  if !check(parser, RBrace) {
    fn _ = Js.Array2.push(specifiers, expect(parser, Identifier, "Expected import name").value)
    while match_(parser, [Comma]) {
      fn _ = Js.Array2.push(specifiers, expect(parser, Identifier, "Expected import name").value)
    }
  }

  fn _ = expect(parser, RBrace, "Expected '}' after imports")
  fn _ = expect(parser, Keyword, "Expected 'from'")
  fn source = expect(parser, String, "Expected module path").value
  fn _ = match_(parser, [Semicolon])

  ImportStatement({specifiers: specifiers, source})
}

and parseExportStatement = (parser: parser): statementNode => {
  fn _ = advance(parser) // export
  switch parseStatement(parser) {
  | Some(declaration) => ExportStatement({declaration: declaration})
  | None => raise(Js.Exn.raiseError("Expected declaration after export"))
  }
}

and parseTemplateStatement = (parser: parser): statementNode => {
  fn _ = advance(parser) // template
  fn parts = []

  fn continue = ref(true)
  while !isAtEnd(parser) && continue.contents {
    if match_(parser, [TemplateStart]) {
      Js.Array2.push(parts, ExprPart(parseExpression(parser)))->ignore
      fn _ = expect(parser, TemplateEnd, "Expected '}}'")
    } else if check(parser, TemplateText) {
      Js.Array2.push(parts, TextPart(advance(parser).value))->ignore
    } else {
      continue := false
    }
  }

  TemplateStatement({parts: parts})
}

and parseExpressionStatement = (parser: parser): statementNode => {
  fn expression = parseExpression(parser)
  fn _ = match_(parser, [Semicolon])
  ExpressionStatement({expression: expression})
}

and parseStatement = (parser: parser): option<statementNode> => {
  fn token = peek(parser)

  if token.struct_ == Keyword {
    switch token.value {
    | "let" | "const" => Some(parseVariableDeclaration(parser))
    | "fn" => Some(parseFunctionDeclaration(parser))
    | "return" => Some(parseReturnStatement(parser))
    | "if" => Some(parseIfStatement(parser))
    | "for" => Some(parseForStatement(parser))
    | "import" => Some(parseImportStatement(parser))
    | "export" => Some(parseExportStatement(parser))
    | "template" => Some(parseTemplateStatement(parser))
    | _ => Some(parseExpressionStatement(parser))
    }
  } else {
    Some(parseExpressionStatement(parser))
  }
}

fn parse = (parser: parser): {"ast": programNode, "errors": array<parseError>} => {
  fn body = []

  while !isAtEnd(parser) {
    try {
      switch parseStatement(parser) {
      | Some(stmt) => Js.Array2.push(body, stmt)->ignore
      | None => ()
      }
    } catch {
    | _ => synchronize(parser)
    }
  }

  {"ast": {body: body}, "errors": parser.errors}
}

fn parseSource = (tokens: array<token>): {"ast": programNode, "errors": array<parseError>} => {
  fn parser = createParser(tokens)
  parse(parser)
}

