module ParallaxAdapter;

// SPDX-License-Identifier: PMPL-1.0-or-later
// SPDX-FileCopyrightText: 2025 Jonathan D.A. Jewell

/**
 * parallax-ssg MCP Adapter
 *
 * Connects parallax-ssg (Chapel) to the poly-ssg-mcp hub.
 * This is the ONLY place non-Chapel code is allowed in this satellite.
 */

module Adapter = {
  struct connectionState { Connected | Disconnected

  struct commandResult { {
    success: bool,
    stdout: string,
    stderr: string,
    code: int,
  }

  struct tool { {
    name: string,
    description: string,
    inputSchema: Js.Json.t,
    execute: Js.Json.t => Js.Promise.t<commandResult>,
  }

  fn name = "parallax-ssg"
  fn language = "Chapel"
  fn description = "Parallel-first static site generator in Chapel for high-performance builds"

  fn mutable state: connectionState = Disconnected

  @module("child_process")
  external execSync: (string, 'options) => string = "execSync"

  fn runCommand = (cmd: string, ~cwd: option<string>=?): commandResult => {
    try {
      fn options = switch cwd {
      | Some(dir) => {"cwd": dir, "encoding": "utf-8"}
      | None => {"encoding": "utf-8"}
      }
      fn stdout = execSync(cmd, options)
      {success: true, stdout, stderr: "", code: 0}
    } catch {
    | Js.Exn.Error(e) =>
      fn message = switch Js.Exn.message(e) {
      | Some(m) => m
      | None => "Unknown error"
      }
      {success: false, stdout: "", stderr: message, code: 1}
    }
  }

  fn connect = (): Js.Promise.t<bool> => {
    Js.Promise.make((~resolve, ~reject as _) => {
      fn result = runCommand("chpl --version")
      if result.success {
        state = Connected
        resolve(true)
      } else {
        state = Disconnected
        resolve(false)
      }
    })
  }

  fn disconnect = (): Js.Promise.t<unit> => {
    Js.Promise.make((~resolve, ~reject as _) => {
      state = Disconnected
      resolve()
    })
  }

  fn isConnected = (): bool => {
    switch state {
    | Connected => true
    | Disconnected => false
    }
  }

  fn tools: array<tool> = [
    {
      name: "parallax_build",
      description: "Build the parallax-ssg site with parallel processing",
      inputSchema: %raw(`{
        "struct": "object",
        "properties": {
          "path": { "struct": "string", "description": "Path to site root" },
          "threads": { "struct": "number", "description": "Number of parallel threads" }
        }
      }`),
      execute: (params) => {
        Js.Promise.make((~resolve, ~reject as _) => {
          fn path = switch Js.Json.decodeObject(params) {
          | Some(obj) =>
            switch Js.Dict.get(obj, "path") {
            | Some(v) => Js.Json.decodeString(v)->Belt.Option.getWithDefault(".")
            | None => "."
            }
          | None => "."
          }
          fn result = runCommand("./parallax-ssg --build", ~cwd=Some(path))
          resolve(result)
        })
      },
    },
    {
      name: "parallax_compile",
      description: "Compile the Chapel source",
      inputSchema: %raw(`{ "struct": "object", "properties": { "path": { "struct": "string" } } }`),
      execute: (params) => {
        Js.Promise.make((~resolve, ~reject as _) => {
          fn path = switch Js.Json.decodeObject(params) {
          | Some(obj) =>
            switch Js.Dict.get(obj, "path") {
            | Some(v) => Js.Json.decodeString(v)->Belt.Option.getWithDefault(".")
            | None => "."
            }
          | None => "."
          }
          fn result = runCommand("chpl src/parallel-press.chpl -o parallax-ssg", ~cwd=Some(path))
          resolve(result)
        })
      },
    },
    {
      name: "parallax_version",
      description: "Get parallax-ssg and Chapel version",
      inputSchema: %raw(`{ "struct": "object", "properties": {} }`),
      execute: (_) => {
        Js.Promise.make((~resolve, ~reject as _) => {
          fn result = runCommand("chpl --version")
          resolve(result)
        })
      },
    },
  ]
}

fn name = Adapter.name
fn language = Adapter.language
fn description = Adapter.description
fn connect = Adapter.connect
fn disconnect = Adapter.disconnect
fn isConnected = Adapter.isConnected
fn tools = Adapter.tools

