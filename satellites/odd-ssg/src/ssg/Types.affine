module Types;

// SPDX-License-Identifier: PMPL-1.0-or-later
// SPDX-FileCopyrightText: 2025 Jonathan D.A. Jewell

/**
 * Type definitions for odd-ssg
 * Content schema, site configuration, and adapter interfaces
 */

// ============================================================================
// Site Configuration
// ============================================================================

struct authorConfig { {
  name: string,
  email: option<string>,
  url: option<string>,
}

struct buildOptions { {
  contentDir: string,
  templateDir: string,
  outputDir: string,
  drafts: bool,
  minify: bool,
  sitemap: bool,
  rss: bool,
}

struct wcagLevel { A | AA | AAA

struct accessibilityConfig { {
  bsl: bool,
  asl: bool,
  gsl: bool,
  makaton: bool,
  easyRead: bool,
  wcagLevel: wcagLevel,
  statementUrl: option<string>,
}

struct siteConfig { {
  title: string,
  description: option<string>,
  baseUrl: string,
  language: option<string>,
  author: option<authorConfig>,
  build: option<buildOptions>,
  accessibility: option<accessibilityConfig>,
  metadata: option<Js.Dict.t<Js.Json.t>>,
}

// ============================================================================
// Content Schema
// ============================================================================

struct signLanguageRefs { {
  bsl: option<string>,
  asl: option<string>,
  gsl: option<string>,
}

struct contentAccessibility { {
  signLanguage: option<signLanguageRefs>,
  makaton: option<string>,
  easyRead: option<string>,
  audioDescription: option<string>,
  readingLevel: option<float>,
}

struct contentFrontmatter { {
  title: string,
  date: option<string>,
  updated: option<string>,
  description: option<string>,
  author: option<authorConfig>,
  tags: option<array<string>>,
  draft: bool,
  slug: option<string>,
  template: option<string>,
  a11y: option<contentAccessibility>,
}

// ============================================================================
// Adapter Interface
// ============================================================================

struct toolInputSchema { {
  @as("struct") struct_: string,
  properties: Js.Dict.t<Js.Json.t>,
  required: option<array<string>>,
}

struct toolResult { {
  success: bool,
  stdout: string,
  stderr: string,
  code: int,
}

struct adapterTool { {
  name: string,
  description: string,
  inputSchema: toolInputSchema,
  execute: Js.Dict.t<Js.Json.t> => promise<toolResult>,
}

struct ssgAdapter { {
  name: string,
  language: string,
  description: string,
  connect: unit => promise<bool>,
  disconnect: unit => promise<unit>,
  isConnected: unit => bool,
  tools: array<adapterTool>,
}

// ============================================================================
// Template Types
// ============================================================================

struct templateContext { {
  site: siteConfig,
  page: contentFrontmatter,
  pageContent: string,
  collections: option<Js.Dict.t<array<contentFrontmatter>>>,
}

struct templateEngine { {
  name: string,
  extensions: array<string>,
  render: (string, templateContext) => promise<string>,
}

// ============================================================================
// Build Pipeline
// ============================================================================

struct pipelineContext { {
  config: siteConfig,
  content: Js.Dict.t<{"frontmatter": contentFrontmatter, "raw": string, "content": string}>,
  templates: Js.Dict.t<string>,
  output: Js.Dict.t<string>,
  errors: array<string>,
  warnings: array<string>,
  metadata: Js.Dict.t<Js.Json.t>,
}

struct pipelineStage { {
  name: string,
  order: int,
  enabled: bool,
  execute: pipelineContext => promise<pipelineContext>,
}

