module MdBook;

// SPDX-License-Identifier: MIT
// SPDX-FileCopyrightText: 2025 Jonathan D.A. Jewell

// mdBook adapter - Create books from Markdown in Rust
// https://rust-lang.github.io/mdBook/

open Adapter

fn name = "MdBook"
fn language = "Rust"
fn description = "Create books from Markdown files using Rust"

fn state: adapterState = {
  connected: false,
  projectPath: None,
}

fn connect = async () => {
  try {
    fn result = await Deno.Command.run("mdbook", ["--version"], None)
    state.connected = result.success
    result.success
  } catch {
  | _ => {
      state.connected = false
      false
    }
  }
}

fn disconnect = async () => {
  state.connected = false
}

fn isConnected = () => state.connected

fn makeSchema = (props: dict<JSON.t>, required: array<string>) => {
  fn schema = Dict.make()
  Dict.set(schema, "struct", JSON.Encode.string("object"))
  Dict.set(schema, "properties", JSON.Encode.object(props))
  if Array.length(required) > 0 {
    Dict.set(schema, "required", JSON.Encode.array(Array.map(required, JSON.Encode.string)))
  }
  JSON.Encode.object(schema)
}

fn makeProp = (structName: string, desc: string) =>
  JSON.Encode.object(
    Dict.fromArray([("struct", JSON.Encode.string(structName)), ("description", JSON.Encode.string(desc))]),
  )

fn tools: array<tool> = [
  {
    name: "mdbook_init",
    description: "Initialize a new mdBook",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path for the new book"))
      Dict.set(props, "title", makeProp("string", "Book title"))
      Dict.set(props, "theme", makeProp("boolean", "Copy default theme"))
      makeSchema(props, [])
    },
  },
  {
    name: "mdbook_build",
    description: "Build the mdBook",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to book root"))
      Dict.set(props, "dest", makeProp("string", "Output directory"))
      Dict.set(props, "open", makeProp("boolean", "Open in browser after build"))
      makeSchema(props, [])
    },
  },
  {
    name: "mdbook_serve",
    description: "Start mdBook development server",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to book root"))
      Dict.set(props, "port", makeProp("number", "Port number (default: 3000)"))
      Dict.set(props, "hostname", makeProp("string", "Hostname to bind to"))
      Dict.set(props, "open", makeProp("boolean", "Open in browser"))
      makeSchema(props, [])
    },
  },
  {
    name: "mdbook_watch",
    description: "Watch for changes and rebuild",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to book root"))
      Dict.set(props, "dest", makeProp("string", "Output directory"))
      makeSchema(props, [])
    },
  },
  {
    name: "mdbook_clean",
    description: "Clean the build directory",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to book root"))
      makeSchema(props, [])
    },
  },
  {
    name: "mdbook_test",
    description: "Test Rust code samples in the book",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to book root"))
      Dict.set(props, "chapter", makeProp("string", "Specific chapter to test"))
      makeSchema(props, [])
    },
  },
  {
    name: "mdbook_version",
    description: "Get mdBook version",
    inputSchema: makeSchema(Dict.make(), []),
  },
]

fn executeInit = async (path: option<string>, title: option<string>, theme: option<bool>) => {
  fn args = ["init"]
  fn args = switch path {
  | Some(p) => Array.concat(args, [p])
  | None => args
  }
  fn args = switch title {
  | Some(t) => Array.concat(args, ["--title", t])
  | None => args
  }
  fn args = switch theme {
  | Some(true) => Array.concat(args, ["--theme"])
  | _ => args
  }
  await Deno.Command.run("mdbook", args, None)
}

fn executeBuild = async (path: option<string>, dest: option<string>, open_: option<bool>) => {
  fn args = ["build"]
  fn args = switch dest {
  | Some(d) => Array.concat(args, ["--dest-dir", d])
  | None => args
  }
  fn args = switch open_ {
  | Some(true) => Array.concat(args, ["--open"])
  | _ => args
  }
  await Deno.Command.run("mdbook", args, path)
}

fn executeServe = async (path: option<string>, port: option<int>, hostname: option<string>, open_: option<bool>) => {
  fn args = ["serve"]
  fn args = switch port {
  | Some(p) => Array.concat(args, ["--port", Int.toString(p)])
  | None => args
  }
  fn args = switch hostname {
  | Some(h) => Array.concat(args, ["--hostname", h])
  | None => args
  }
  fn args = switch open_ {
  | Some(true) => Array.concat(args, ["--open"])
  | _ => args
  }
  await Deno.Command.run("mdbook", args, path)
}

fn executeWatch = async (path: option<string>, dest: option<string>) => {
  fn args = ["watch"]
  fn args = switch dest {
  | Some(d) => Array.concat(args, ["--dest-dir", d])
  | None => args
  }
  await Deno.Command.run("mdbook", args, path)
}

fn executeClean = async (path: option<string>) => {
  await Deno.Command.run("mdbook", ["clean"], path)
}

fn executeTest = async (path: option<string>, chapter: option<string>) => {
  fn args = ["test"]
  fn args = switch chapter {
  | Some(c) => Array.concat(args, ["--chapter", c])
  | None => args
  }
  await Deno.Command.run("mdbook", args, path)
}

fn executeVersion = async () => {
  await Deno.Command.run("mdbook", ["--version"], None)
}

