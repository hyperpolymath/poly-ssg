module Pollen;

// SPDX-License-Identifier: MIT
// SPDX-FileCopyrightText: 2025 Jonathan D.A. Jewell

// Pollen adapter - Programmable publishing system in Racket
// https://docs.racket-lang.org/pollen/

open Adapter

fn name = "Pollen"
fn language = "Racket"
fn description = "Programmable publishing system for making books in Racket"

fn state: adapterState = {
  connected: false,
  projectPath: None,
}

fn connect = async () => {
  try {
    fn result = await Deno.Command.run("raco", ["pollen", "version"], None)
    state.connected = result.success
    result.success
  } catch {
  | _ => {
      state.connected = false
      false
    }
  }
}

fn disconnect = async () => {
  state.connected = false
}

fn isConnected = () => state.connected

fn makeSchema = (props: dict<JSON.t>, required: array<string>) => {
  fn schema = Dict.make()
  Dict.set(schema, "struct", JSON.Encode.string("object"))
  Dict.set(schema, "properties", JSON.Encode.object(props))
  if Array.length(required) > 0 {
    Dict.set(schema, "required", JSON.Encode.array(Array.map(required, JSON.Encode.string)))
  }
  JSON.Encode.object(schema)
}

fn makeProp = (structName: string, desc: string) =>
  JSON.Encode.object(
    Dict.fromArray([("struct", JSON.Encode.string(structName)), ("description", JSON.Encode.string(desc))]),
  )

fn tools: array<tool> = [
  {
    name: "pollen_start",
    description: "Start Pollen project server",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to project root"))
      Dict.set(props, "port", makeProp("number", "Port number (default: 8080)"))
      makeSchema(props, [])
    },
  },
  {
    name: "pollen_render",
    description: "Render Pollen source files",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to project root"))
      Dict.set(props, "parallel", makeProp("boolean", "Render in parallel"))
      makeSchema(props, [])
    },
  },
  {
    name: "pollen_publish",
    description: "Publish rendered files to output directory",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to project root"))
      Dict.set(props, "output", makeProp("string", "Output directory"))
      makeSchema(props, [])
    },
  },
  {
    name: "pollen_reset",
    description: "Reset Pollen cache",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to project root"))
      makeSchema(props, [])
    },
  },
  {
    name: "pollen_version",
    description: "Get Pollen version",
    inputSchema: makeSchema(Dict.make(), []),
  },
]

fn executeStart = async (path: option<string>, port: option<int>) => {
  fn args = ["pollen", "start"]
  fn args = switch port {
  | Some(p) => Array.concat(args, [Int.toString(p)])
  | None => args
  }
  await Deno.Command.run("raco", args, path)
}

fn executeRender = async (path: option<string>, parallel: option<bool>) => {
  fn args = ["pollen", "render"]
  fn args = switch parallel {
  | Some(true) => Array.concat(args, ["-p"])
  | _ => args
  }
  await Deno.Command.run("raco", args, path)
}

fn executePublish = async (path: option<string>, output: option<string>) => {
  fn args = ["pollen", "publish"]
  fn args = switch output {
  | Some(o) => Array.concat(args, [o])
  | None => args
  }
  await Deno.Command.run("raco", args, path)
}

fn executeReset = async (path: option<string>) => {
  await Deno.Command.run("raco", ["pollen", "reset"], path)
}

fn executeVersion = async () => {
  await Deno.Command.run("raco", ["pollen", "version"], None)
}

