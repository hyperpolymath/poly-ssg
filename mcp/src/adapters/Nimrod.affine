module Nimrod;

// SPDX-License-Identifier: MIT
// SPDX-FileCopyrightText: 2025 Jonathan D.A. Jewell

// Nimrod adapter - Static site generator in Nim
// Nim-based static site generation

open Adapter

fn name = "Nimrod"
fn language = "Nim"
fn description = "Static site generator written in Nim"

fn state: adapterState = {
  connected: false,
  projectPath: None,
}

fn connect = async () => {
  try {
    fn result = await Deno.Command.run("nim", ["--version"], None)
    state.connected = result.success
    result.success
  } catch {
  | _ => {
      state.connected = false
      false
    }
  }
}

fn disconnect = async () => {
  state.connected = false
}

fn isConnected = () => state.connected

fn makeSchema = (props: dict<JSON.t>, required: array<string>) => {
  fn schema = Dict.make()
  Dict.set(schema, "struct", JSON.Encode.string("object"))
  Dict.set(schema, "properties", JSON.Encode.object(props))
  if Array.length(required) > 0 {
    Dict.set(schema, "required", JSON.Encode.array(Array.map(required, JSON.Encode.string)))
  }
  JSON.Encode.object(schema)
}

fn makeProp = (structName: string, desc: string) =>
  JSON.Encode.object(
    Dict.fromArray([("struct", JSON.Encode.string(structName)), ("description", JSON.Encode.string(desc))]),
  )

fn tools: array<tool> = [
  {
    name: "nimrod_init",
    description: "Initialize a new Nimrod site",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path for the new site"))
      Dict.set(props, "template", makeProp("string", "Template to use"))
      makeSchema(props, ["path"])
    },
  },
  {
    name: "nimrod_build",
    description: "Build the Nimrod site",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to site root"))
      Dict.set(props, "release", makeProp("boolean", "Build in release mode"))
      makeSchema(props, [])
    },
  },
  {
    name: "nimrod_serve",
    description: "Start Nimrod development server",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to site root"))
      Dict.set(props, "port", makeProp("number", "Port number"))
      makeSchema(props, [])
    },
  },
  {
    name: "nimrod_clean",
    description: "Clean build artifacts",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to site root"))
      makeSchema(props, [])
    },
  },
  {
    name: "nimrod_version",
    description: "Get Nim version",
    inputSchema: makeSchema(Dict.make(), []),
  },
]

fn executeInit = async (path: string, template: option<string>) => {
  fn args = ["init", path]
  fn args = switch template {
  | Some(t) => Array.concat(args, ["--template", t])
  | None => args
  }
  await Deno.Command.run("nimrod", args, None)
}

fn executeBuild = async (path: option<string>, release: option<bool>) => {
  fn args = ["build"]
  fn args = switch release {
  | Some(true) => Array.concat(args, ["--release"])
  | _ => args
  }
  await Deno.Command.run("nimrod", args, path)
}

fn executeServe = async (path: option<string>, port: option<int>) => {
  fn args = ["serve"]
  fn args = switch port {
  | Some(p) => Array.concat(args, ["--port", Int.toString(p)])
  | None => args
  }
  await Deno.Command.run("nimrod", args, path)
}

fn executeClean = async (path: option<string>) => {
  await Deno.Command.run("nimrod", ["clean"], path)
}

fn executeVersion = async () => {
  await Deno.Command.run("nim", ["--version"], None)
}

