module Perun;

// SPDX-License-Identifier: MIT
// SPDX-FileCopyrightText: 2025 Jonathan D.A. Jewell

// Perun adapter - Composable static site generator in Clojure
// https://perun.io/

open Adapter

fn name = "Perun"
fn language = "Clojure"
fn description = "Composable static site generator using Boot build tool"

fn state: adapterState = {
  connected: false,
  projectPath: None,
}

fn connect = async () => {
  try {
    fn result = await Deno.Command.run("boot", ["--version"], None)
    state.connected = result.success
    result.success
  } catch {
  | _ => {
      state.connected = false
      false
    }
  }
}

fn disconnect = async () => {
  state.connected = false
}

fn isConnected = () => state.connected

fn makeSchema = (props: dict<JSON.t>, required: array<string>) => {
  fn schema = Dict.make()
  Dict.set(schema, "struct", JSON.Encode.string("object"))
  Dict.set(schema, "properties", JSON.Encode.object(props))
  if Array.length(required) > 0 {
    Dict.set(schema, "required", JSON.Encode.array(Array.map(required, JSON.Encode.string)))
  }
  JSON.Encode.object(schema)
}

fn makeProp = (structName: string, desc: string) =>
  JSON.Encode.object(
    Dict.fromArray([("struct", JSON.Encode.string(structName)), ("description", JSON.Encode.string(desc))]),
  )

fn tools: array<tool> = [
  {
    name: "perun_init",
    description: "Initialize a new Perun project",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path for the new project"))
      makeSchema(props, ["path"])
    },
  },
  {
    name: "perun_build",
    description: "Build the Perun site",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to project root"))
      Dict.set(props, "target", makeProp("string", "Build target"))
      makeSchema(props, [])
    },
  },
  {
    name: "perun_dev",
    description: "Start development mode with watch",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to project root"))
      Dict.set(props, "port", makeProp("number", "Port number"))
      makeSchema(props, [])
    },
  },
  {
    name: "perun_version",
    description: "Get Boot version",
    inputSchema: makeSchema(Dict.make(), []),
  },
]

fn executeInit = async (path: string) => {
  await Deno.Command.run("boot", ["new", "perun", path], None)
}

fn executeBuild = async (path: option<string>, target: option<string>) => {
  fn args = switch target {
  | Some(t) => [t]
  | None => ["build"]
  }
  await Deno.Command.run("boot", args, path)
}

fn executeDev = async (path: option<string>, port: option<int>) => {
  fn args = ["dev"]
  fn args = switch port {
  | Some(p) => Array.concat(args, ["-p", Int.toString(p)])
  | None => args
  }
  await Deno.Command.run("boot", args, path)
}

fn executeVersion = async () => {
  await Deno.Command.run("boot", ["--version"], None)
}

