module YOCaml;

// SPDX-License-Identifier: MIT
// SPDX-FileCopyrightText: 2025 Jonathan D.A. Jewell

// YOCaml adapter - Static site generator in OCaml
// https://github.com/xhtmlboi/yocaml

open Adapter

fn name = "YOCaml"
fn language = "OCaml"
fn description = "Static site generator in OCaml with composable build rules"

fn state: adapterState = {
  connected: false,
  projectPath: None,
}

fn connect = async () => {
  try {
    fn result = await Deno.Command.run("opam", ["--version"], None)
    state.connected = result.success
    result.success
  } catch {
  | _ => {
      state.connected = false
      false
    }
  }
}

fn disconnect = async () => {
  state.connected = false
}

fn isConnected = () => state.connected

fn makeSchema = (props: dict<JSON.t>, required: array<string>) => {
  fn schema = Dict.make()
  Dict.set(schema, "struct", JSON.Encode.string("object"))
  Dict.set(schema, "properties", JSON.Encode.object(props))
  if Array.length(required) > 0 {
    Dict.set(schema, "required", JSON.Encode.array(Array.map(required, JSON.Encode.string)))
  }
  JSON.Encode.object(schema)
}

fn makeProp = (structName: string, desc: string) =>
  JSON.Encode.object(
    Dict.fromArray([("struct", JSON.Encode.string(structName)), ("description", JSON.Encode.string(desc))]),
  )

fn tools: array<tool> = [
  {
    name: "yocaml_init",
    description: "Initialize a new YOCaml project",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "name", makeProp("string", "Project name"))
      Dict.set(props, "path", makeProp("string", "Path for the project"))
      makeSchema(props, ["name"])
    },
  },
  {
    name: "yocaml_build",
    description: "Build the YOCaml site",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to project root"))
      makeSchema(props, [])
    },
  },
  {
    name: "yocaml_watch",
    description: "Watch and rebuild on changes",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to project root"))
      makeSchema(props, [])
    },
  },
  {
    name: "yocaml_clean",
    description: "Clean build artifacts",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to project root"))
      makeSchema(props, [])
    },
  },
  {
    name: "yocaml_version",
    description: "Get opam/OCaml version",
    inputSchema: makeSchema(Dict.make(), []),
  },
]

fn executeInit = async (name: string, path: option<string>) => {
  await Deno.Command.run("dune", ["init", "project", name], path)
}

fn executeBuild = async (path: option<string>) => {
  await Deno.Command.run("dune", ["build"], path)
}

fn executeWatch = async (path: option<string>) => {
  await Deno.Command.run("dune", ["build", "--watch"], path)
}

fn executeClean = async (path: option<string>) => {
  await Deno.Command.run("dune", ["clean"], path)
}

fn executeVersion = async () => {
  await Deno.Command.run("opam", ["--version"], None)
}

