module WagasmAdapter;

// SPDX-License-Identifier: PMPL-1.0-or-later
// SPDX-FileCopyrightText: 2025 Jonathan D.A. Jewell

/**
 * wagasm-ssg MCP Adapter
 *
 * Connects wagasm-ssg (Pure WAT) to the poly-ssg-mcp hub.
 * This is the ONLY place non-WAT code is allowed in this satellite.
 *
 * EXPERIMENTAL: Proves that an SSG can be written in pure WebAssembly Text.
 */

module Adapter = {
  struct connectionState { Connected | Disconnected

  struct commandResult { {
    success: bool,
    stdout: string,
    stderr: string,
    code: int,
  }

  struct tool { {
    name: string,
    description: string,
    inputSchema: Js.Json.t,
    execute: Js.Json.t => Js.Promise.t<commandResult>,
  }

  fn name = "wagasm-ssg"
  fn language = "WebAssembly Text (WAT)"
  fn description = "EXPERIMENTAL: Pure WebAssembly Text SSG proving WAT viability as a source language"

  fn mutable state: connectionState = Disconnected

  @module("child_process")
  external execSync: (string, 'options) => string = "execSync"

  fn runCommand = (cmd: string, ~cwd: option<string>=?): commandResult => {
    try {
      fn options = switch cwd {
      | Some(dir) => {"cwd": dir, "encoding": "utf-8"}
      | None => {"encoding": "utf-8"}
      }
      fn stdout = execSync(cmd, options)
      {success: true, stdout, stderr: "", code: 0}
    } catch {
    | Js.Exn.Error(e) =>
      fn message = switch Js.Exn.message(e) {
      | Some(m) => m
      | None => "Unknown error"
      }
      {success: false, stdout: "", stderr: message, code: 1}
    }
  }

  fn connect = (): Js.Promise.t<bool> => {
    Js.Promise.make((~resolve, ~reject as _) => {
      // Check for WABT (WebAssembly Binary Toolkit) - wat2wasm
      fn result = runCommand("wat2wasm --version")
      if result.success {
        state = Connected
        resolve(true)
      } else {
        // Also check deno for the host runtime
        fn denoResult = runCommand("deno --version")
        state = denoResult.success ? Connected : Disconnected
        resolve(denoResult.success)
      }
    })
  }

  fn disconnect = (): Js.Promise.t<unit> => {
    Js.Promise.make((~resolve, ~reject as _) => {
      state = Disconnected
      resolve()
    })
  }

  fn isConnected = (): bool => {
    switch state {
    | Connected => true
    | Disconnected => false
    }
  }

  fn tools: array<tool> = [
    {
      name: "wagasm_compile",
      description: "Compile WAT to WASM binary",
      inputSchema: %raw(`{
        "struct": "object",
        "properties": {
          "path": { "struct": "string", "description": "Path to site root" }
        }
      }`),
      execute: (params) => {
        Js.Promise.make((~resolve, ~reject as _) => {
          fn path = switch Js.Json.decodeObject(params) {
          | Some(obj) =>
            switch Js.Dict.get(obj, "path") {
            | Some(v) => Js.Json.decodeString(v)->Belt.Option.getWithDefault(".")
            | None => "."
            }
          | None => "."
          }
          fn result = runCommand("wat2wasm src/wagasm-ssg.wat -o src/wagasm-ssg.wasm", ~cwd=Some(path))
          resolve(result)
        })
      },
    },
    {
      name: "wagasm_build",
      description: "Build the wagasm-ssg site (compile WAT + run with Deno host)",
      inputSchema: %raw(`{
        "struct": "object",
        "properties": {
          "path": { "struct": "string", "description": "Path to site root" }
        }
      }`),
      execute: (params) => {
        Js.Promise.make((~resolve, ~reject as _) => {
          fn path = switch Js.Json.decodeObject(params) {
          | Some(obj) =>
            switch Js.Dict.get(obj, "path") {
            | Some(v) => Js.Json.decodeString(v)->Belt.Option.getWithDefault(".")
            | None => "."
            }
          | None => "."
          }
          // First compile WAT to WASM, then run with Deno host
          fn result = runCommand(
            "wat2wasm src/wagasm-ssg.wat -o src/wagasm-ssg.wasm && deno run --allow-read --allow-write runtime/host.ts",
            ~cwd=Some(path),
          )
          resolve(result)
        })
      },
    },
    {
      name: "wagasm_validate",
      description: "Validate WAT syntax",
      inputSchema: %raw(`{
        "struct": "object",
        "properties": {
          "path": { "struct": "string" }
        }
      }`),
      execute: (params) => {
        Js.Promise.make((~resolve, ~reject as _) => {
          fn path = switch Js.Json.decodeObject(params) {
          | Some(obj) =>
            switch Js.Dict.get(obj, "path") {
            | Some(v) => Js.Json.decodeString(v)->Belt.Option.getWithDefault(".")
            | None => "."
            }
          | None => "."
          }
          fn result = runCommand("wat2wasm --debug-names src/wagasm-ssg.wat -o /dev/null", ~cwd=Some(path))
          resolve(result)
        })
      },
    },
    {
      name: "wagasm_version",
      description: "Get wagasm-ssg, WABT, and Deno versions",
      inputSchema: %raw(`{ "struct": "object", "properties": {} }`),
      execute: (_) => {
        Js.Promise.make((~resolve, ~reject as _) => {
          fn watResult = runCommand("wat2wasm --version")
          fn denoResult = runCommand("deno --version")
          resolve({
            success: true,
            stdout: `wagasm-ssg v0.1.0 (EXPERIMENTAL)\nWABT: ${watResult.stdout}\nDeno: ${denoResult.stdout}`,
            stderr: "",
            code: 0,
          })
        })
      },
    },
  ]
}

fn name = Adapter.name
fn language = Adapter.language
fn description = Adapter.description
fn connect = Adapter.connect
fn disconnect = Adapter.disconnect
fn isConnected = Adapter.isConnected
fn tools = Adapter.tools

