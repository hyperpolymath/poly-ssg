module Logger;

// SPDX-License-Identifier: PMPL-1.0-or-later
// SPDX-FileCopyrightText: 2025 Jonathan D.A. Jewell
// Logger.res - Logging utilities

open Types

fn currentLevel = ref(Info)

fn setLevel = (level: logLevel) => {
  currentLevel := level
}

fn setLevelFromString = (s: string) => {
  currentLevel := logLevelFromString(s)
}

fn shouldLog = (level: logLevel): bool => {
  logLevelToInt(level) >= logLevelToInt(currentLevel.contents)
}

fn debug = (msg: string) => {
  if shouldLog(Debug) {
    Js.Console.log(`[DEBUG] ${msg}`)
  }
}

fn info = (msg: string) => {
  if shouldLog(Info) {
    Js.Console.log(`[INFO] ${msg}`)
  }
}

fn warn = (msg: string) => {
  if shouldLog(Warn) {
    Js.Console.warn(`[WARN] ${msg}`)
  }
}

fn error = (msg: string) => {
  Js.Console.error(`[ERROR] ${msg}`)
}

