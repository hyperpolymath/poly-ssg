// Hakyll adapter - Static site generator in Haskell
// https://jaspervdj.be/hakyll/

open Adapter

fn name = "Hakyll"
fn language = "Haskell"
fn description = "Haskell library for generating static sites with Pandoc support"

fn state: adapterState = {
  connected: false,
  projectPath: None,
}

fn connect = async () => {
  try {
    fn result = await Deno.Command.run("stack", ["--version"], None)
    state.connected = result.success
    result.success
  } catch {
  | _ => {
      state.connected = false
      false
    }
  }
}

fn disconnect = async () => {
  state.connected = false
}

fn isConnected = () => state.connected

fn makeSchema = (props: dict<JSON.t>, required: array<string>) => {
  fn schema = Dict.make()
  Dict.set(schema, "struct", JSON.Encode.string("object"))
  Dict.set(schema, "properties", JSON.Encode.object(props))
  if Array.length(required) > 0 {
    Dict.set(schema, "required", JSON.Encode.array(Array.map(required, JSON.Encode.string)))
  }
  JSON.Encode.object(schema)
}

fn makeProp = (structName: string, desc: string) =>
  JSON.Encode.object(
    Dict.fromArray([("struct", JSON.Encode.string(structName)), ("description", JSON.Encode.string(desc))]),
  )

fn tools: array<tool> = [
  {
    name: "hakyll_init",
    description: "Initialize a new Hakyll site (using stack template)",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "name", makeProp("string", "Project name"))
      Dict.set(props, "path", makeProp("string", "Path for the project"))
      makeSchema(props, ["name"])
    },
  },
  {
    name: "hakyll_build",
    description: "Build the Hakyll site",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to site root"))
      makeSchema(props, [])
    },
  },
  {
    name: "hakyll_watch",
    description: "Start Hakyll watch server",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to site root"))
      Dict.set(props, "port", makeProp("number", "Port number"))
      Dict.set(props, "host", makeProp("string", "Host to bind to"))
      makeSchema(props, [])
    },
  },
  {
    name: "hakyll_clean",
    description: "Clean the build cache",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to site root"))
      makeSchema(props, [])
    },
  },
  {
    name: "hakyll_rebuild",
    description: "Clean and rebuild the site",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to site root"))
      makeSchema(props, [])
    },
  },
  {
    name: "hakyll_check",
    description: "Check for broken links",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to site root"))
      Dict.set(props, "internal", makeProp("boolean", "Check internal links only"))
      makeSchema(props, [])
    },
  },
  {
    name: "hakyll_deploy",
    description: "Deploy the site",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to site root"))
      makeSchema(props, [])
    },
  },
  {
    name: "hakyll_version",
    description: "Get Stack/Hakyll version",
    inputSchema: makeSchema(Dict.make(), []),
  },
]

// Helper for running site commands via stack exec
fn runSiteCommand = async (args: array<string>, path: option<string>) => {
  await Deno.Command.run("stack", Array.concat(["exec", "site", "--"], args), path)
}

fn executeInit = async (name: string, path: option<string>) => {
  await Deno.Command.run("stack", ["new", name, "hakyll-template"], path)
}

fn executeBuild = async (path: option<string>) => {
  await runSiteCommand(["build"], path)
}

fn executeWatch = async (path: option<string>, port: option<int>, host: option<string>) => {
  fn args = ["watch"]
  fn args = switch port {
  | Some(p) => Array.concat(args, ["--port", Int.toString(p)])
  | None => args
  }
  fn args = switch host {
  | Some(h) => Array.concat(args, ["--host", h])
  | None => args
  }
  await runSiteCommand(args, path)
}

fn executeClean = async (path: option<string>) => {
  await runSiteCommand(["clean"], path)
}

fn executeRebuild = async (path: option<string>) => {
  await runSiteCommand(["rebuild"], path)
}

fn executeCheck = async (path: option<string>, internal: option<bool>) => {
  fn args = ["check"]
  fn args = switch internal {
  | Some(true) => Array.concat(args, ["--internal-links"])
  | _ => args
  }
  await runSiteCommand(args, path)
}

fn executeDeploy = async (path: option<string>) => {
  await runSiteCommand(["deploy"], path)
}

fn executeVersion = async () => {
  await Deno.Command.run("stack", ["--version"], None)
}

