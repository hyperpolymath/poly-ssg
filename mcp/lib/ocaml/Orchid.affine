module Orchid;

// SPDX-License-Identifier: MIT
// SPDX-FileCopyrightText: 2025 Jonathan D.A. Jewell

// Orchid adapter - Static site generator in Kotlin
// https://orchid.run/

open Adapter

fn name = "Orchid"
fn language = "Kotlin"
fn description = "Powerful static site generator in Kotlin with plugin system"

fn state: adapterState = {
  connected: false,
  projectPath: None,
}

fn connect = async () => {
  try {
    fn result = await Deno.Command.run("orchid", ["--version"], None)
    state.connected = result.success
    result.success
  } catch {
  | _ => {
      state.connected = false
      false
    }
  }
}

fn disconnect = async () => {
  state.connected = false
}

fn isConnected = () => state.connected

fn makeSchema = (props: dict<JSON.t>, required: array<string>) => {
  fn schema = Dict.make()
  Dict.set(schema, "struct", JSON.Encode.string("object"))
  Dict.set(schema, "properties", JSON.Encode.object(props))
  if Array.length(required) > 0 {
    Dict.set(schema, "required", JSON.Encode.array(Array.map(required, JSON.Encode.string)))
  }
  JSON.Encode.object(schema)
}

fn makeProp = (structName: string, desc: string) =>
  JSON.Encode.object(
    Dict.fromArray([("struct", JSON.Encode.string(structName)), ("description", JSON.Encode.string(desc))]),
  )

fn tools: array<tool> = [
  {
    name: "orchid_init",
    description: "Initialize a new Orchid project",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path for the new project"))
      Dict.set(props, "theme", makeProp("string", "Theme to use (Editorial, Copper, etc.)"))
      makeSchema(props, [])
    },
  },
  {
    name: "orchid_build",
    description: "Build the Orchid site",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to project root"))
      Dict.set(props, "environment", makeProp("string", "Build environment (debug, production)"))
      makeSchema(props, [])
    },
  },
  {
    name: "orchid_serve",
    description: "Start Orchid development server",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to project root"))
      Dict.set(props, "port", makeProp("number", "Port number (default: 8080)"))
      makeSchema(props, [])
    },
  },
  {
    name: "orchid_deploy",
    description: "Deploy the Orchid site",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to project root"))
      Dict.set(props, "destination", makeProp("string", "Deploy destination"))
      makeSchema(props, [])
    },
  },
  {
    name: "orchid_version",
    description: "Get Orchid version",
    inputSchema: makeSchema(Dict.make(), []),
  },
]

fn executeInit = async (path: option<string>, theme: option<string>) => {
  fn args = ["init"]
  fn args = switch path {
  | Some(p) => Array.concat(args, [p])
  | None => args
  }
  fn args = switch theme {
  | Some(t) => Array.concat(args, ["--theme", t])
  | None => args
  }
  await Deno.Command.run("orchid", args, None)
}

fn executeBuild = async (path: option<string>, environment: option<string>) => {
  fn args = ["build"]
  fn args = switch environment {
  | Some(e) => Array.concat(args, ["--environment", e])
  | None => args
  }
  await Deno.Command.run("orchid", args, path)
}

fn executeServe = async (path: option<string>, port: option<int>) => {
  fn args = ["serve"]
  fn args = switch port {
  | Some(p) => Array.concat(args, ["--port", Int.toString(p)])
  | None => args
  }
  await Deno.Command.run("orchid", args, path)
}

fn executeDeploy = async (path: option<string>, destination: option<string>) => {
  fn args = ["deploy"]
  fn args = switch destination {
  | Some(d) => Array.concat(args, ["--destination", d])
  | None => args
  }
  await Deno.Command.run("orchid", args, path)
}

fn executeVersion = async () => {
  await Deno.Command.run("orchid", ["--version"], None)
}

