module Publish;

// SPDX-License-Identifier: MIT
// SPDX-FileCopyrightText: 2025 Jonathan D.A. Jewell

// Publish adapter - Static site generator in Swift
// https://github.com/JohnSundell/Publish

open Adapter

fn name = "Publish"
fn language = "Swift"
fn description = "Static site generator for Swift developers"

fn state: adapterState = {
  connected: false,
  projectPath: None,
}

fn connect = async () => {
  try {
    fn result = await Deno.Command.run("publish", ["--version"], None)
    state.connected = result.success
    result.success
  } catch {
  | _ => {
      state.connected = false
      false
    }
  }
}

fn disconnect = async () => {
  state.connected = false
}

fn isConnected = () => state.connected

fn makeSchema = (props: dict<JSON.t>, required: array<string>) => {
  fn schema = Dict.make()
  Dict.set(schema, "struct", JSON.Encode.string("object"))
  Dict.set(schema, "properties", JSON.Encode.object(props))
  if Array.length(required) > 0 {
    Dict.set(schema, "required", JSON.Encode.array(Array.map(required, JSON.Encode.string)))
  }
  JSON.Encode.object(schema)
}

fn makeProp = (structName: string, desc: string) =>
  JSON.Encode.object(
    Dict.fromArray([("struct", JSON.Encode.string(structName)), ("description", JSON.Encode.string(desc))]),
  )

fn tools: array<tool> = [
  {
    name: "publish_new",
    description: "Create a new Publish site",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path for the new site"))
      makeSchema(props, [])
    },
  },
  {
    name: "publish_generate",
    description: "Generate the Publish site",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to site root"))
      makeSchema(props, [])
    },
  },
  {
    name: "publish_run",
    description: "Run the Publish development server",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to site root"))
      Dict.set(props, "port", makeProp("number", "Port number (default: 8000)"))
      makeSchema(props, [])
    },
  },
  {
    name: "publish_deploy",
    description: "Deploy the site",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to site root"))
      Dict.set(props, "method", makeProp("string", "Deploy method (git, github)"))
      makeSchema(props, [])
    },
  },
  {
    name: "publish_version",
    description: "Get Publish version",
    inputSchema: makeSchema(Dict.make(), []),
  },
]

fn executeNew = async (path: option<string>) => {
  fn args = ["new"]
  fn args = switch path {
  | Some(p) => Array.concat(args, [p])
  | None => args
  }
  await Deno.Command.run("publish", args, None)
}

fn executeGenerate = async (path: option<string>) => {
  await Deno.Command.run("publish", ["generate"], path)
}

fn executeRun = async (path: option<string>, port: option<int>) => {
  fn args = ["run"]
  fn args = switch port {
  | Some(p) => Array.concat(args, ["--port", Int.toString(p)])
  | None => args
  }
  await Deno.Command.run("publish", args, path)
}

fn executeDeploy = async (path: option<string>, method: option<string>) => {
  fn args = ["deploy"]
  fn args = switch method {
  | Some(m) => Array.concat(args, ["--" ++ m])
  | None => args
  }
  await Deno.Command.run("publish", args, path)
}

fn executeVersion = async () => {
  await Deno.Command.run("publish", ["--version"], None)
}

