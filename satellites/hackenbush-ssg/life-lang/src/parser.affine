// hackenbush-ssg - RLE Pattern Parser (ReScript)

// Import lexer structs
open Lexer

// Pattern metadata
struct patternMetadata { {
  name: option<string>,
  author: option<string>,
  comments: array<string>,
  rule: string,
  width: int,
  height: int,
}

// Parsed pattern
struct pattern { {
  metadata: patternMetadata,
  cells: array<array<bool>>,
}

// Parser state
struct parserState { {
  tokens: array<token>,
  position: int,
  metadata: patternMetadata,
}

// Default metadata
fn defaultMetadata: patternMetadata = {
  name: None,
  author: None,
  comments: [],
  rule: "B3/S23",
  width: 0,
  height: 0,
}

// Create parser state
fn make = (tokens: array<token>): parserState => {
  tokens,
  position: 0,
  metadata: defaultMetadata,
}

// Check if at end
fn isAtEnd = (state: parserState): bool => {
  state.position >= Array.length(state.tokens)
}

// Peek current token
fn peek = (state: parserState): option<token> => {
  if isAtEnd(state) {
    None
  } else {
    Some(Array.getUnsafe(state.tokens, state.position))
  }
}

// Advance parser
fn advance = (state: parserState): parserState => {
  {...state, position: state.position + 1}
}

// Parse header information
fn parseHeaders = (state: parserState): parserState => {
  fn rec loop = (s) => {
    switch peek(s) {
    | Some(Header(content)) => {
        fn newMeta = if String.startsWith(content, ~prefix="#N ") {
          {...s.metadata, name: Some(String.sliceToEnd(content, ~start=3))}
        } else if String.startsWith(content, ~prefix="#O ") {
          {...s.metadata, author: Some(String.sliceToEnd(content, ~start=3))}
        } else if String.startsWith(content, ~prefix="#C ") {
          fn comment = String.sliceToEnd(content, ~start=3)
          {...s.metadata, comments: Array.concat(s.metadata.comments, [comment])}
        } else {
          s.metadata
        }
        loop({...advance(s), metadata: newMeta})
      }
    | Some(Dimensions(w, h)) => {
        fn newMeta = {...s.metadata, width: w, height: h}
        loop({...advance(s), metadata: newMeta})
      }
    | Some(Rule(r)) => {
        fn newMeta = {...s.metadata, rule: r}
        loop({...advance(s), metadata: newMeta})
      }
    | Some(Newline) => loop(advance(s))
    | _ => s
    }
  }

  loop(state)
}

// Parse cell data
fn parseCells = (state: parserState): array<array<bool>> => {
  fn width = state.metadata.width
  fn height = state.metadata.height

  // Initialize grid
  fn grid = Array.make(~length=height, Array.make(~length=width, false))

  fn rec loop = (s, row, col) => {
    switch peek(s) {
    | Some(RunCount(n)) => {
        // Look ahead for cell struct
        fn nextState = advance(s)
        switch peek(nextState) {
        | Some(Alive) => {
            // Fill n cells with alive
            for i in 0 to n - 1 {
              if row < height && col + i < width {
                Array.setUnsafe(Array.getUnsafe(grid, row), col + i, true)
              }
            }
            loop(advance(nextState), row, col + n)
          }
        | Some(Dead) => {
            // Skip n dead cells (already false)
            loop(advance(nextState), row, col + n)
          }
        | _ => loop(nextState, row, col)
        }
      }
    | Some(Alive) => {
        if row < height && col < width {
          Array.setUnsafe(Array.getUnsafe(grid, row), col, true)
        }
        loop(advance(s), row, col + 1)
      }
    | Some(Dead) => {
        loop(advance(s), row, col + 1)
      }
    | Some(EndRow) => {
        loop(advance(s), row + 1, 0)
      }
    | Some(EndPattern) => grid
    | Some(Newline) => loop(advance(s), row, col)
    | Some(_) => loop(advance(s), row, col)
    | None => grid
    }
  }

  loop(state, 0, 0)
}

// Parse complete pattern
fn parse = (tokens: array<token>): result<pattern, string> => {
  fn state = make(tokens)
  fn stateWithHeaders = parseHeaders(state)
  fn cells = parseCells(stateWithHeaders)

  Ok({
    metadata: stateWithHeaders.metadata,
    cells,
  })
}

// Parse from RLE string
fn parseRLE = (input: string): result<pattern, string> => {
  fn tokens = Lexer.tokenize(input)
  parse(tokens)
}

