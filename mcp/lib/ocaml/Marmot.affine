module Marmot;

// SPDX-License-Identifier: MIT
// SPDX-FileCopyrightText: 2025 Jonathan D.A. Jewell

// Marmot adapter - Static site generator in Crystal
// https://github.com/MakeNowJust/marmot

open Adapter

fn name = "Marmot"
fn language = "Crystal"
fn description = "Fast static site generator written in Crystal"

fn state: adapterState = {
  connected: false,
  projectPath: None,
}

fn connect = async () => {
  try {
    fn result = await Deno.Command.run("marmot", ["--version"], None)
    state.connected = result.success
    result.success
  } catch {
  | _ => {
      state.connected = false
      false
    }
  }
}

fn disconnect = async () => {
  state.connected = false
}

fn isConnected = () => state.connected

fn makeSchema = (props: dict<JSON.t>, required: array<string>) => {
  fn schema = Dict.make()
  Dict.set(schema, "struct", JSON.Encode.string("object"))
  Dict.set(schema, "properties", JSON.Encode.object(props))
  if Array.length(required) > 0 {
    Dict.set(schema, "required", JSON.Encode.array(Array.map(required, JSON.Encode.string)))
  }
  JSON.Encode.object(schema)
}

fn makeProp = (structName: string, desc: string) =>
  JSON.Encode.object(
    Dict.fromArray([("struct", JSON.Encode.string(structName)), ("description", JSON.Encode.string(desc))]),
  )

fn tools: array<tool> = [
  {
    name: "marmot_init",
    description: "Initialize a new Marmot site",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path for the new site"))
      makeSchema(props, [])
    },
  },
  {
    name: "marmot_build",
    description: "Build the Marmot site",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to site root"))
      Dict.set(props, "output", makeProp("string", "Output directory"))
      makeSchema(props, [])
    },
  },
  {
    name: "marmot_serve",
    description: "Start Marmot development server",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to site root"))
      Dict.set(props, "port", makeProp("number", "Port number"))
      makeSchema(props, [])
    },
  },
  {
    name: "marmot_watch",
    description: "Watch for changes and rebuild",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to site root"))
      makeSchema(props, [])
    },
  },
  {
    name: "marmot_version",
    description: "Get Marmot version",
    inputSchema: makeSchema(Dict.make(), []),
  },
]

fn executeInit = async (path: option<string>) => {
  fn args = ["init"]
  fn args = switch path {
  | Some(p) => Array.concat(args, [p])
  | None => args
  }
  await Deno.Command.run("marmot", args, None)
}

fn executeBuild = async (path: option<string>, output: option<string>) => {
  fn args = ["build"]
  fn args = switch output {
  | Some(o) => Array.concat(args, ["--output", o])
  | None => args
  }
  await Deno.Command.run("marmot", args, path)
}

fn executeServe = async (path: option<string>, port: option<int>) => {
  fn args = ["serve"]
  fn args = switch port {
  | Some(p) => Array.concat(args, ["--port", Int.toString(p)])
  | None => args
  }
  await Deno.Command.run("marmot", args, path)
}

fn executeWatch = async (path: option<string>) => {
  await Deno.Command.run("marmot", ["watch"], path)
}

fn executeVersion = async () => {
  await Deno.Command.run("marmot", ["--version"], None)
}

