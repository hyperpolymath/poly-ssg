module Cryogen;

// SPDX-License-Identifier: MIT
// SPDX-FileCopyrightText: 2025 Jonathan D.A. Jewell

// Cryogen adapter - Static site generator in Clojure
// https://cryogenweb.org/

open Adapter

fn name = "Cryogen"
fn language = "Clojure"
fn description = "Simple static site generator using Clojure and Leiningen"

fn state: adapterState = {
  connected: false,
  projectPath: None,
}

fn connect = async () => {
  try {
    fn result = await Deno.Command.run("lein", ["version"], None)
    state.connected = result.success
    result.success
  } catch {
  | _ => {
      state.connected = false
      false
    }
  }
}

fn disconnect = async () => {
  state.connected = false
}

fn isConnected = () => state.connected

fn makeSchema = (props: dict<JSON.t>, required: array<string>) => {
  fn schema = Dict.make()
  Dict.set(schema, "struct", JSON.Encode.string("object"))
  Dict.set(schema, "properties", JSON.Encode.object(props))
  if Array.length(required) > 0 {
    Dict.set(schema, "required", JSON.Encode.array(Array.map(required, JSON.Encode.string)))
  }
  JSON.Encode.object(schema)
}

fn makeProp = (structName: string, desc: string) =>
  JSON.Encode.object(
    Dict.fromArray([("struct", JSON.Encode.string(structName)), ("description", JSON.Encode.string(desc))]),
  )

fn tools: array<tool> = [
  {
    name: "cryogen_new",
    description: "Create a new Cryogen site",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "name", makeProp("string", "Project name"))
      Dict.set(props, "path", makeProp("string", "Path for the project"))
      makeSchema(props, ["name"])
    },
  },
  {
    name: "cryogen_build",
    description: "Build the Cryogen site",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to project root"))
      makeSchema(props, [])
    },
  },
  {
    name: "cryogen_serve",
    description: "Start Cryogen development server",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to project root"))
      Dict.set(props, "port", makeProp("number", "Port number (default: 3000)"))
      makeSchema(props, [])
    },
  },
  {
    name: "cryogen_new_post",
    description: "Create a new blog post",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to project root"))
      Dict.set(props, "title", makeProp("string", "Post title"))
      makeSchema(props, ["title"])
    },
  },
  {
    name: "cryogen_version",
    description: "Get Leiningen version",
    inputSchema: makeSchema(Dict.make(), []),
  },
]

fn executeNew = async (name: string, path: option<string>) => {
  await Deno.Command.run("lein", ["new", "cryogen", name], path)
}

fn executeBuild = async (path: option<string>) => {
  await Deno.Command.run("lein", ["run"], path)
}

fn executeServe = async (path: option<string>, port: option<int>) => {
  fn args = ["ring", "server"]
  fn args = switch port {
  | Some(p) => Array.concat(args, [Int.toString(p)])
  | None => args
  }
  await Deno.Command.run("lein", args, path)
}

fn executeNewPost = async (path: option<string>, title: string) => {
  await Deno.Command.run("lein", ["run", "-m", "cryogen.core/new-post!", title], path)
}

fn executeVersion = async () => {
  await Deno.Command.run("lein", ["version"], None)
}

