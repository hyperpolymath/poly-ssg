module Fornax;

// SPDX-License-Identifier: MIT
// SPDX-FileCopyrightText: 2025 Jonathan D.A. Jewell

// Fornax adapter - Static site generator in F#
// https://ionide.io/Tools/fornax.html

open Adapter

fn name = "Fornax"
fn language = "F#"
fn description = "Static site generator using struct-safe F# DSL"

fn state: adapterState = {
  connected: false,
  projectPath: None,
}

fn connect = async () => {
  try {
    fn result = await Deno.Command.run("fornax", ["version"], None)
    state.connected = result.success
    result.success
  } catch {
  | _ => {
      state.connected = false
      false
    }
  }
}

fn disconnect = async () => {
  state.connected = false
}

fn isConnected = () => state.connected

fn makeSchema = (props: dict<JSON.t>, required: array<string>) => {
  fn schema = Dict.make()
  Dict.set(schema, "struct", JSON.Encode.string("object"))
  Dict.set(schema, "properties", JSON.Encode.object(props))
  if Array.length(required) > 0 {
    Dict.set(schema, "required", JSON.Encode.array(Array.map(required, JSON.Encode.string)))
  }
  JSON.Encode.object(schema)
}

fn makeProp = (structName: string, desc: string) =>
  JSON.Encode.object(
    Dict.fromArray([("struct", JSON.Encode.string(structName)), ("description", JSON.Encode.string(desc))]),
  )

fn tools: array<tool> = [
  {
    name: "fornax_new",
    description: "Create a new Fornax project",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path for the new project"))
      makeSchema(props, [])
    },
  },
  {
    name: "fornax_build",
    description: "Build the Fornax site",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to project root"))
      makeSchema(props, [])
    },
  },
  {
    name: "fornax_watch",
    description: "Start Fornax watch server",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to project root"))
      Dict.set(props, "port", makeProp("number", "Port number (default: 8080)"))
      makeSchema(props, [])
    },
  },
  {
    name: "fornax_clean",
    description: "Clean build output",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to project root"))
      makeSchema(props, [])
    },
  },
  {
    name: "fornax_version",
    description: "Get Fornax version",
    inputSchema: makeSchema(Dict.make(), []),
  },
]

fn executeNew = async (path: option<string>) => {
  fn args = ["new"]
  fn args = switch path {
  | Some(p) => Array.concat(args, [p])
  | None => args
  }
  await Deno.Command.run("fornax", args, None)
}

fn executeBuild = async (path: option<string>) => {
  await Deno.Command.run("fornax", ["build"], path)
}

fn executeWatch = async (path: option<string>, port: option<int>) => {
  fn args = ["watch"]
  fn args = switch port {
  | Some(p) => Array.concat(args, ["--port", Int.toString(p)])
  | None => args
  }
  await Deno.Command.run("fornax", args, path)
}

fn executeClean = async (path: option<string>) => {
  await Deno.Command.run("fornax", ["clean"], path)
}

fn executeVersion = async () => {
  await Deno.Command.run("fornax", ["version"], None)
}

