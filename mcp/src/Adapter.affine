// Adapter interface structs for SSG MCP server

struct toolInput { {.}

struct toolExecutor { JSON.t => promise<JSON.t>

struct tool { {
  name: string,
  description: string,
  inputSchema: JSON.t,
  execute?: toolExecutor,
}

struct adapterState { {
  mutable connected: bool,
  mutable projectPath: option<string>,
}

struct adapter { {
  name: string,
  description: string,
  language: string,
  connect: unit => promise<bool>,
  disconnect: unit => promise<unit>,
  isConnected: unit => bool,
  tools: array<tool>,
}

// Standard tools that every SSG adapter should implement
fn standardTools = [
  "init",      // Initialize new project
  "build",     // Build the site
  "serve",     // Start dev server
  "clean",     // Clean build artifacts
  "version",   // Show version
  "new_post",  // Create new content
  "new_page",  // Create new page
  "check",     // Check/validate site
  "deploy",    // Deploy site
]

