module HackenbushAdapter;

// SPDX-License-Identifier: PMPL-1.0-or-later
// SPDX-FileCopyrightText: 2025 Jonathan D.A. Jewell

/**
 * hackenbush-ssg MCP Adapter
 *
 * Connects hackenbush-ssg to the poly-ssg-mcp hub.
 * This is the ONLY place non-native code is allowed in this satellite.
 */

module Adapter = {
  struct connectionState { Connected | Disconnected

  struct commandResult { {
    success: bool,
    stdout: string,
    stderr: string,
    code: int,
  }

  struct tool { {
    name: string,
    description: string,
    inputSchema: Js.Json.t,
    execute: Js.Json.t => Js.Promise.t<commandResult>,
  }

  fn name = "hackenbush-ssg"
  fn language = "Game of Life / Cellular Automata"
  fn description = "Static site generator using Conway's Game of Life patterns for generative content"

  fn mutable state: connectionState = Disconnected

  @module("child_process")
  external execSync: (string, 'options) => string = "execSync"

  fn runCommand = (cmd: string, ~cwd: option<string>=?): commandResult => {
    try {
      fn options = switch cwd {
      | Some(dir) => {"cwd": dir, "encoding": "utf-8"}
      | None => {"encoding": "utf-8"}
      }
      fn stdout = execSync(cmd, options)
      {success: true, stdout, stderr: "", code: 0}
    } catch {
    | Js.Exn.Error(e) =>
      fn message = switch Js.Exn.message(e) {
      | Some(m) => m
      | None => "Unknown error"
      }
      {success: false, stdout: "", stderr: message, code: 1}
    }
  }

  fn connect = (): Js.Promise.t<bool> => {
    Js.Promise.make((~resolve, ~reject as _) => {
      fn result = runCommand("node --version")
      if result.success {
        state = Connected
        resolve(true)
      } else {
        state = Disconnected
        resolve(false)
      }
    })
  }

  fn disconnect = (): Js.Promise.t<unit> => {
    Js.Promise.make((~resolve, ~reject as _) => {
      state = Disconnected
      resolve()
    })
  }

  fn isConnected = (): bool => {
    switch state {
    | Connected => true
    | Disconnected => false
    }
  }

  fn tools: array<tool> = [
    {
      name: "hackenbush_build",
      description: "Build the hackenbush-ssg site using Game of Life patterns",
      inputSchema: %raw(`{
        "struct": "object",
        "properties": {
          "path": { "struct": "string", "description": "Path to site root" },
          "pattern": { "struct": "string", "description": "Initial Life pattern (e.g., glider, blinker, pulsar)" }
        }
      }`),
      execute: (params) => {
        Js.Promise.make((~resolve, ~reject as _) => {
          fn path = switch Js.Json.decodeObject(params) {
          | Some(obj) =>
            switch Js.Dict.get(obj, "path") {
            | Some(v) =>
              switch Js.Json.decodeString(v) {
              | Some(s) => s
              | None => "."
              }
            | None => "."
            }
          | None => "."
          }
          fn result = runCommand("node src/main.js build", ~cwd=Some(path))
          resolve(result)
        })
      },
    },
    {
      name: "hackenbush_generate",
      description: "Generate content from a Game of Life pattern",
      inputSchema: %raw(`{
        "struct": "object",
        "properties": {
          "path": { "struct": "string", "description": "Path to site root" },
          "generations": { "struct": "number", "description": "Number of generations to simulate" },
          "width": { "struct": "number", "description": "Grid width" },
          "height": { "struct": "number", "description": "Grid height" }
        }
      }`),
      execute: (params) => {
        Js.Promise.make((~resolve, ~reject as _) => {
          fn path = switch Js.Json.decodeObject(params) {
          | Some(obj) =>
            switch Js.Dict.get(obj, "path") {
            | Some(v) =>
              switch Js.Json.decodeString(v) {
              | Some(s) => s
              | None => "."
              }
            | None => "."
            }
          | None => "."
          }
          fn result = runCommand("node src/life.js generate", ~cwd=Some(path))
          resolve(result)
        })
      },
    },
    {
      name: "hackenbush_version",
      description: "Get hackenbush-ssg version",
      inputSchema: %raw(`{ "struct": "object", "properties": {} }`),
      execute: (_) => {
        Js.Promise.make((~resolve, ~reject as _) => {
          resolve({success: true, stdout: "hackenbush-ssg v0.1.0", stderr: "", code: 0})
        })
      },
    },
  ]
}

// Export for MCP hub
fn name = Adapter.name
fn language = Adapter.language
fn description = Adapter.description
fn connect = Adapter.connect
fn disconnect = Adapter.disconnect
fn isConnected = Adapter.isConnected
fn tools = Adapter.tools

