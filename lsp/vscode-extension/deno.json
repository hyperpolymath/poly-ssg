{
  "tasks": {
    "compile": "deno run -A npm:typescript/bin/tsc -p ./",
    "watch": "deno run -A npm:typescript/bin/tsc -watch -p ./",
    "package": "deno run -A npm:@vscode/vsce package"
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": true
  }
}
