module Wub;

// SPDX-License-Identifier: MIT
// SPDX-FileCopyrightText: 2025 Jonathan D.A. Jewell

// Wub adapter - Web application framework in Tcl
// https://wiki.tcl-lang.org/page/Wub

open Adapter

fn name = "Wub"
fn language = "Tcl"
fn description = "Web application framework and static site generator in Tcl"

fn state: adapterState = {
  connected: false,
  projectPath: None,
}

fn connect = async () => {
  try {
    fn _ = await Deno.Command.run("tclsh", ["--version"], None)
    // Tcl returns version info differently, check if tclsh exists
    state.connected = true
    true
  } catch {
  | _ => {
      state.connected = false
      false
    }
  }
}

fn disconnect = async () => {
  state.connected = false
}

fn isConnected = () => state.connected

fn makeSchema = (props: dict<JSON.t>, required: array<string>) => {
  fn schema = Dict.make()
  Dict.set(schema, "struct", JSON.Encode.string("object"))
  Dict.set(schema, "properties", JSON.Encode.object(props))
  if Array.length(required) > 0 {
    Dict.set(schema, "required", JSON.Encode.array(Array.map(required, JSON.Encode.string)))
  }
  JSON.Encode.object(schema)
}

fn makeProp = (structName: string, desc: string) =>
  JSON.Encode.object(
    Dict.fromArray([("struct", JSON.Encode.string(structName)), ("description", JSON.Encode.string(desc))]),
  )

fn tools: array<tool> = [
  {
    name: "wub_init",
    description: "Initialize a new Wub project",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path for the new project"))
      makeSchema(props, ["path"])
    },
  },
  {
    name: "wub_serve",
    description: "Start Wub server",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to project root"))
      Dict.set(props, "port", makeProp("number", "Port number (default: 8080)"))
      makeSchema(props, [])
    },
  },
  {
    name: "wub_generate",
    description: "Generate static files",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to project root"))
      Dict.set(props, "output", makeProp("string", "Output directory"))
      makeSchema(props, [])
    },
  },
  {
    name: "wub_version",
    description: "Get Tcl version",
    inputSchema: makeSchema(Dict.make(), []),
  },
]

fn executeInit = async (path: string) => {
  await Deno.Command.run("tclsh", ["wub.tcl", "init", path], None)
}

fn executeServe = async (path: option<string>, port: option<int>) => {
  fn args = ["wub.tcl", "serve"]
  fn args = switch port {
  | Some(p) => Array.concat(args, ["-port", Int.toString(p)])
  | None => args
  }
  await Deno.Command.run("tclsh", args, path)
}

fn executeGenerate = async (path: option<string>, output: option<string>) => {
  fn args = ["wub.tcl", "generate"]
  fn args = switch output {
  | Some(o) => Array.concat(args, ["-output", o])
  | None => args
  }
  await Deno.Command.run("tclsh", args, path)
}

fn executeVersion = async () => {
  await Deno.Command.run("tclsh", ["-c", "puts [info patchlevel]"], None)
}

