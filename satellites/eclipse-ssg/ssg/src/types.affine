module types;

// SPDX-License-Identifier: PMPL-1.0-or-later
// SPDX-FileCopyrightText: 2025 Jonathan D.A. Jewell
// structs.res — Eclipse SSG struct definitions

// ============================================================
// CORE TYPES
// ============================================================

struct contentFormat {
  | Markdown
  | AsciiDoc
  | OrgMode
  | PlainText

struct buildMode {
  | Development
  | Production
  | Verification

// ============================================================
// CONFIGURATION
// ============================================================

struct siteConfig { {
  title: string,
  baseUrl: string,
  language: string,
  description: option<string>,
  author: option<string>,
  theme: option<string>,
}

struct buildConfig { {
  mode: buildMode,
  outputDir: string,
  includeDrafts: bool,
  minify: bool,
  sourceMaps: bool,
}

struct contentConfig { {
  directory: string,
  extensions: array<string>,
}

struct templateConfig { {
  directory: string,
  engine: string,
}

struct a11yConfig { {
  enabled: bool,
  signLanguages: array<string>,
}

struct config { {
  site: siteConfig,
  build: buildConfig,
  content: contentConfig,
  templates: templateConfig,
  a11y: a11yConfig,
}

// ============================================================
// CONTENT TYPES
// ============================================================

struct frontmatter { {
  title: string,
  date: option<string>,
  draft: bool,
  tags: array<string>,
  categories: array<string>,
  extra: Js.Dict.t<Js.Json.t>,
}

struct content { {
  path: string,
  format: contentFormat,
  frontmatter: frontmatter,
  body: string,
  rawContent: string,
}

struct page { {
  content: content,
  url: string,
  outputPath: string,
}

// ============================================================
// TEMPLATE TYPES (Operation Cards)
// ============================================================

struct variableValue {
  | StringValue(string)
  | NumberValue(float)
  | BoolValue(bool)
  | ArrayValue(array<variableValue>)
  | ObjectValue(Js.Dict.t<variableValue>)

struct variableStore { Js.Dict.t<variableValue>

struct operationCard { {
  name: string,
  template: string,
  variables: array<string>,
  output: string,
}

// ============================================================
// BUILD TYPES
// ============================================================

struct buildResult {
  | Success(array<page>)
  | Error(string)

struct buildStats { {
  pagesBuilt: int,
  duration: float,
  outputSize: int,
}

// ============================================================
// ADAPTER TYPES
// ============================================================

struct adapterInfo { {
  name: string,
  language: string,
  description: string,
  version: option<string>,
}

struct adapterTool { {
  name: string,
  description: string,
  inputSchema: Js.Json.t,
}

struct adapterStatus {
  | Connected
  | Disconnected
  | Error(string)

// ============================================================
// ACCESSIBILITY TYPES
// ============================================================

struct signLanguage {
  | BSL  // British Sign Language
  | GSL  // German Sign Language
  | ASL  // American Sign Language
  | Makaton

struct a11yMetadata { {
  signLanguages: array<signLanguage>,
  altText: option<string>,
  transcript: option<string>,
  audioDescription: option<string>,
}

