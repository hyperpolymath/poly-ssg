// Zotonic adapter - CMS and framework in Erlang
// https://zotonic.com/

open Adapter

fn name = "Zotonic"
fn language = "Erlang"
fn description = "Content management system and web framework in Erlang"

fn state: adapterState = {
  connected: false,
  projectPath: None,
}

fn connect = async () => {
  try {
    fn result = await Deno.Command.run("zotonic", ["status"], None)
    state.connected = result.success
    result.success
  } catch {
  | _ => {
      state.connected = false
      false
    }
  }
}

fn disconnect = async () => {
  state.connected = false
}

fn isConnected = () => state.connected

fn makeSchema = (props: dict<JSON.t>, required: array<string>) => {
  fn schema = Dict.make()
  Dict.set(schema, "struct", JSON.Encode.string("object"))
  Dict.set(schema, "properties", JSON.Encode.object(props))
  if Array.length(required) > 0 {
    Dict.set(schema, "required", JSON.Encode.array(Array.map(required, JSON.Encode.string)))
  }
  JSON.Encode.object(schema)
}

fn makeProp = (structName: string, desc: string) =>
  JSON.Encode.object(
    Dict.fromArray([("struct", JSON.Encode.string(structName)), ("description", JSON.Encode.string(desc))]),
  )

fn tools: array<tool> = [
  {
    name: "zotonic_siteadd",
    description: "Add a new Zotonic site",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "name", makeProp("string", "Site name"))
      Dict.set(props, "hostname", makeProp("string", "Site hostname"))
      makeSchema(props, ["name"])
    },
  },
  {
    name: "zotonic_start",
    description: "Start Zotonic",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to Zotonic installation"))
      makeSchema(props, [])
    },
  },
  {
    name: "zotonic_stop",
    description: "Stop Zotonic",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to Zotonic installation"))
      makeSchema(props, [])
    },
  },
  {
    name: "zotonic_sitestart",
    description: "Start a specific site",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "name", makeProp("string", "Site name"))
      makeSchema(props, ["name"])
    },
  },
  {
    name: "zotonic_sitestop",
    description: "Stop a specific site",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "name", makeProp("string", "Site name"))
      makeSchema(props, ["name"])
    },
  },
  {
    name: "zotonic_compile",
    description: "Compile Zotonic",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to Zotonic installation"))
      makeSchema(props, [])
    },
  },
  {
    name: "zotonic_version",
    description: "Get Zotonic version",
    inputSchema: makeSchema(Dict.make(), []),
  },
]

fn executeSiteadd = async (name: string, hostname: option<string>) => {
  fn args = ["siteadd", name]
  fn args = switch hostname {
  | Some(h) => Array.concat(args, ["-h", h])
  | None => args
  }
  await Deno.Command.run("zotonic", args, None)
}

fn executeStart = async (path: option<string>) => {
  await Deno.Command.run("zotonic", ["start"], path)
}

fn executeStop = async (path: option<string>) => {
  await Deno.Command.run("zotonic", ["stop"], path)
}

fn executeSitestart = async (name: string) => {
  await Deno.Command.run("zotonic", ["sitestart", name], None)
}

fn executeSitestop = async (name: string) => {
  await Deno.Command.run("zotonic", ["sitestop", name], None)
}

fn executeCompile = async (path: option<string>) => {
  await Deno.Command.run("zotonic", ["compile"], path)
}

fn executeVersion = async () => {
  await Deno.Command.run("zotonic", ["status"], None)
}

