module Babashka;

// SPDX-License-Identifier: MIT
// SPDX-FileCopyrightText: 2025 Jonathan D.A. Jewell

// Babashka adapter - Fast native Clojure scripting
// https://babashka.org/

open Adapter

fn name = "Babashka"
fn language = "Clojure"
fn description = "Fast native Clojure scripting runtime for static site tasks"

fn state: adapterState = {
  connected: false,
  projectPath: None,
}

fn connect = async () => {
  try {
    fn result = await Deno.Command.run("bb", ["--version"], None)
    state.connected = result.success
    result.success
  } catch {
  | _ => {
      state.connected = false
      false
    }
  }
}

fn disconnect = async () => {
  state.connected = false
}

fn isConnected = () => state.connected

fn makeSchema = (props: dict<JSON.t>, required: array<string>) => {
  fn schema = Dict.make()
  Dict.set(schema, "struct", JSON.Encode.string("object"))
  Dict.set(schema, "properties", JSON.Encode.object(props))
  if Array.length(required) > 0 {
    Dict.set(schema, "required", JSON.Encode.array(Array.map(required, JSON.Encode.string)))
  }
  JSON.Encode.object(schema)
}

fn makeProp = (structName: string, desc: string) =>
  JSON.Encode.object(
    Dict.fromArray([("struct", JSON.Encode.string(structName)), ("description", JSON.Encode.string(desc))]),
  )

fn tools: array<tool> = [
  {
    name: "bb_run",
    description: "Run a Babashka script",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "script", makeProp("string", "Script file to run"))
      Dict.set(props, "path", makeProp("string", "Working directory"))
      Dict.set(props, "args", makeProp("string", "Arguments to pass"))
      makeSchema(props, ["script"])
    },
  },
  {
    name: "bb_tasks",
    description: "List available bb.edn tasks",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "path", makeProp("string", "Path to project root"))
      makeSchema(props, [])
    },
  },
  {
    name: "bb_task",
    description: "Run a bb.edn task",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "task", makeProp("string", "Task name"))
      Dict.set(props, "path", makeProp("string", "Path to project root"))
      makeSchema(props, ["task"])
    },
  },
  {
    name: "bb_nrepl",
    description: "Start nREPL server",
    inputSchema: {
      fn props = Dict.make()
      Dict.set(props, "port", makeProp("number", "nREPL port"))
      Dict.set(props, "path", makeProp("string", "Working directory"))
      makeSchema(props, [])
    },
  },
  {
    name: "bb_version",
    description: "Get Babashka version",
    inputSchema: makeSchema(Dict.make(), []),
  },
]

fn executeRun = async (script: string, path: option<string>, args: option<string>) => {
  fn cmdArgs = [script]
  fn cmdArgs = switch args {
  | Some(a) => Array.concat(cmdArgs, [a])
  | None => cmdArgs
  }
  await Deno.Command.run("bb", cmdArgs, path)
}

fn executeTasks = async (path: option<string>) => {
  await Deno.Command.run("bb", ["tasks"], path)
}

fn executeTask = async (task: string, path: option<string>) => {
  await Deno.Command.run("bb", [task], path)
}

fn executeNrepl = async (port: option<int>, path: option<string>) => {
  fn args = ["nrepl-server"]
  fn args = switch port {
  | Some(p) => Array.concat(args, [Int.toString(p)])
  | None => args
  }
  await Deno.Command.run("bb", args, path)
}

fn executeVersion = async () => {
  await Deno.Command.run("bb", ["--version"], None)
}

